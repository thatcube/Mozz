<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mozz.Desktop"
             x:Class="Mozz.Desktop.App"
             Name="Mozz"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- The macOS application menu.
         Without one, Avalonia installs its own default, whose first item is
         "About Avalonia" — so the app told anyone who looked what it was built
         with rather than what it is. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Mozz" Click="OnAboutMozz" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tabler icon geometries, generated from tools/icons/tabler-svg/
                     by tools/icons/build-desktop-icons.sh. Merging them here makes
                     every Icon* key StaticResource-able app-wide. -->
                <ResourceInclude Source="avares://Mozz.Desktop/Assets/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="InterFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

            <!-- Mozz crimson, taken from the iOS app icon so the two read as
                 one product rather than two apps that share a name. -->
            <SolidColorBrush x:Key="Accent" Color="#D8213F" />
            <SolidColorBrush x:Key="AccentHover" Color="#E63A55" />
            <SolidColorBrush x:Key="AccentDeep" Color="#B00023" />

            <!-- Near-black rather than black: Apple Music and Spotify both do
                 this, and it stops album art appearing to float. -->
            <SolidColorBrush x:Key="AppBackground" Color="#0B0B0D" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#121214" />
            <SolidColorBrush x:Key="BarBackground" Color="#141416" />
            <SolidColorBrush x:Key="SurfaceRaised" Color="#1C1C20" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#232328" />
            <SolidColorBrush x:Key="SurfaceSelected" Color="#2A2A30" />
            <SolidColorBrush x:Key="Divider" Color="#232327" />

            <!-- What separates a raised surface from the page in Black, where the
                 two are the same colour. Transparent and zero-width in Dim and
                 Light, so every surface that opts in is unchanged there.
                 DesktopPalette swaps both. -->
            <SolidColorBrush x:Key="SurfaceBorder" Color="Transparent" />
            <Thickness x:Key="SurfaceBorderThickness">0</Thickness>

            <!-- The wash under an artist banner's name. Declared here so the
                 template can bind it at load; DesktopPalette replaces it with
                 one that fades into whichever background is in effect. -->
            <LinearGradientBrush x:Key="HeroScrim" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#000B0B0D" Offset="0" />
                <GradientStop Color="#CC0B0B0D" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F4" />
            <SolidColorBrush x:Key="TextSecondary" Color="#9A9AA2" />
            <SolidColorBrush x:Key="TextTertiary" Color="#6A6A72" />

            <!-- Fluent's own accent, overridden to the same crimson.
                 The brushes above only reach controls we style by hand. Every
                 built-in control — the sliders, the progress bar, list
                 selection, focus rings — reads SystemAccentColor instead, which
                 ships as a Windows blue. Leaving it meant the seek bar, the
                 volume slider and the selected row were all bright blue in an
                 otherwise crimson app, which read as unfinished rather than as
                 a choice. The Light/Dark ramp is what Fluent reaches for on
                 hover, press and disabled states, so all six are given rather
                 than just the base. -->
            <Color x:Key="SystemAccentColor">#D8213F</Color>
            <Color x:Key="SystemAccentColorLight1">#E63A55</Color>
            <Color x:Key="SystemAccentColorLight2">#EE5C73</Color>
            <Color x:Key="SystemAccentColorLight3">#F58193</Color>
            <Color x:Key="SystemAccentColorDark1">#B00023</Color>
            <Color x:Key="SystemAccentColorDark2">#8C001C</Color>
            <Color x:Key="SystemAccentColorDark3">#680015</Color>

            <!-- Slider geometry.
                 Fluent's horizontal slider is a three-row grid — a 15px spacer,
                 the thumb, another 15px spacer — around a 20px thumb, so it
                 wants 50px of height. Asking for an 18px-tall slider did not
                 shrink that template, it cropped it: the thumb was clipped to a
                 half circle and the track was squeezed to a hairline. The way
                 to get a compact scrubber is to shrink the parts the template
                 measures, not to squeeze the control around them. -->
            <GridLength x:Key="SliderPreContentMargin">0</GridLength>
            <GridLength x:Key="SliderPostContentMargin">0</GridLength>
            <x:Double x:Key="SliderHorizontalHeight">18</x:Double>
            <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
            <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
            <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>

            <!-- Slider colour. The played side is crimson, the rest is a muted
                 rail that stays visible against the near-black bar, and the
                 handle is near-white so it reads against the played side. -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#3A3A42" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#45454F" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#45454F" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#2A2A30" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#D8213F" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#E63A55" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#E63A55" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#5A2A32" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#F2F2F4" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#6A6A72" />

            <!-- The template paints a plate behind the whole slider on hover.
                 In a transport bar that is a grey rectangle appearing under the
                 scrubber whenever the pointer crosses it. -->
            <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
            <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        </Style>

        <!-- Selection, for every list that does not say otherwise.
             Fluent fills the selected row edge to edge with the accent colour.
             Next to album art that is a solid bar of paint across the window,
             and it looks nothing like the sidebar, which marks its current item
             with a quiet raised surface and crimson text. Do the same here: the
             surface carries the selection and the title carries the colour.
             Lists whose rows are only a layout device — the album and artist
             walls — still override this locally to nothing. -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus-within /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock.primary">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.link:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.transport">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <!-- Icons bind their Brush to this Foreground; secondary at rest keeps
                 shuffle / repeat / queue / volume quiet so the transport reads as a
                 hierarchy rather than a row of equally loud glyphs. -->
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- The stray blue rounded-rect behind Next was Fluent's
                 DefaultFocusAdorner: the AdornerLayer draws it around whatever last
                 took focus, and clicking a button focuses it. Opt out the same way
                 ComboBox/TextBox do, then supply a keyboard-only ring below so the
                 control stays accessible without the pointer artefact. -->
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <!-- Previous / next lead the secondary controls: full-strength foreground. -->
        <Style Selector="Button.transport.lead">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.transport:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="Button.transport:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="Button.transport:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <Style Selector="Button.play">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Style>
        <!-- Press deepens the crimson rather than flashing Fluent's grey pressed fill. -->
        <Style Selector="Button.play:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDeep}" />
        </Style>
        <Style Selector="Button.play:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Style>
        <Style Selector="Button.detailAction">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.secondaryAction">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="{DynamicResource SurfaceBorderThickness}" />
        </Style>
        <Style Selector="Button.secondaryAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="Button.secondaryAction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.primary">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Also the artwork placeholder: in Black its fill is the page's own
             black, so the hairline is the only thing that makes a coverless
             album a cover-shaped hole rather than nothing. -->
        <Style Selector="Border.albumArt">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="{DynamicResource SurfaceBorderThickness}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- Slim transport sliders (scrubber + volume) sized for the 88px bar. -->
        <Style Selector="Slider.scrub">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
