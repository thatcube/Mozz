<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mozz.Desktop"
             x:Class="Mozz.Desktop.App"
             Name="Mozz"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="InterFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

            <!-- Mozz crimson, taken from the iOS app icon so the two read as
                 one product rather than two apps that share a name. -->
            <SolidColorBrush x:Key="Accent" Color="#D8213F" />
            <SolidColorBrush x:Key="AccentHover" Color="#E63A55" />
            <SolidColorBrush x:Key="AccentDeep" Color="#B00023" />

            <!-- Near-black rather than black: Apple Music and Spotify both do
                 this, and it stops album art appearing to float. -->
            <SolidColorBrush x:Key="AppBackground" Color="#0B0B0D" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#121214" />
            <SolidColorBrush x:Key="BarBackground" Color="#141416" />
            <SolidColorBrush x:Key="SurfaceRaised" Color="#1C1C20" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#232328" />
            <SolidColorBrush x:Key="SurfaceSelected" Color="#2A2A30" />
            <SolidColorBrush x:Key="Divider" Color="#232327" />

            <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F4" />
            <SolidColorBrush x:Key="TextSecondary" Color="#9A9AA2" />
            <SolidColorBrush x:Key="TextTertiary" Color="#6A6A72" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
            <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.transport">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Button.play">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Style>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.primary">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Border.albumArt">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- Slim transport sliders (scrubber + volume) sized for the 88px bar. -->
        <Style Selector="Slider.scrub">
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
