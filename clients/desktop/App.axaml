<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mozz.Desktop"
             x:Class="Mozz.Desktop.App"
             Name="Mozz">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- The macOS application menu.
         Without one, Avalonia installs its own default, whose first item is
         "About Avalonia" — so the app told anyone who looked what it was built
         with rather than what it is. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Mozz" Click="OnAboutMozz" />
            <NativeMenuItem Header="Settings…" Gesture="Cmd+," Click="OnSettingsMozz" />
            <NativeMenuItem Header="Your Devices…" Click="OnPairDevice" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tabler icon geometries, generated from tools/icons/tabler-svg/
                     by tools/icons/build-desktop-icons.sh. Merging them here makes
                     every Icon* key StaticResource-able app-wide. -->
                <ResourceInclude Source="avares://Mozz.Desktop/Assets/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="InterFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

            <!-- Initial values are replaced by MozzThemeApplicator after preferences
                 load. They match the iOS dark-dim ladder so startup never flashes red. -->
            <SolidColorBrush x:Key="Accent" Color="#F50031" />
            <SolidColorBrush x:Key="AccentHover" Color="#FF244E" />
            <SolidColorBrush x:Key="AccentDeep" Color="#C80028" />
            <SolidColorBrush x:Key="Brand" Color="#F50031" />
            <SolidColorBrush x:Key="BrandForeground" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AppBackground" Color="#1C1C1E" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#2C2C2E" />
            <SolidColorBrush x:Key="BarBackground" Color="#2C2C2E" />
            <SolidColorBrush x:Key="Surface" Color="#2C2C2E" />
            <SolidColorBrush x:Key="SurfaceRaised" Color="#3A3A3C" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#48484A" />
            <SolidColorBrush x:Key="SurfaceSelected" Color="#3A3A3C" />
            <SolidColorBrush x:Key="DetailBackground" Color="#121212" />
            <SolidColorBrush x:Key="Divider" Color="#99545458" />

            <!-- The dock's own surface. Lifted off the page rather than equal
                 to it, so the pill reads as laid on top; DesktopPalette swaps
                 both for the light and blackout ladders. -->
            <SolidColorBrush x:Key="DockBackground" Color="#F21C1C20" />
            <SolidColorBrush x:Key="DockBorder" Color="#26FFFFFF" />

            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#99EBEBF5" />
            <SolidColorBrush x:Key="TextTertiary" Color="#4DEBEBF5" />
            <SolidColorBrush x:Key="SearchBackground" Color="#3A3A3C" />
            <SolidColorBrush x:Key="ArtworkFallbackPrimary" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ArtworkFallbackSecondary" Color="#88FFFFFF" />
            <SolidColorBrush x:Key="ArtworkFallbackTertiary" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="ArtworkHeroFallback" Color="#44FFFFFF" />
            <Color x:Key="HeroGradientStart">#00000000</Color>
            <Color x:Key="HeroGradientEnd">#CC121212</Color>

            <!-- Fluent's accent powers built-in controls. Keep it neutral; use Mozz
                 brand red only through the explicit primary/play/destructive styles. -->
            <Color x:Key="SystemAccentColor">#8E8E93</Color>
            <Color x:Key="SystemAccentColorLight1">#AEAEB2</Color>
            <Color x:Key="SystemAccentColorLight2">#C7C7CC</Color>
            <Color x:Key="SystemAccentColorLight3">#D1D1D6</Color>
            <Color x:Key="SystemAccentColorDark1">#6C6C70</Color>
            <Color x:Key="SystemAccentColorDark2">#545458</Color>
            <Color x:Key="SystemAccentColorDark3">#3A3A3C</Color>

            <!-- Slider geometry.
                 Fluent's horizontal slider is a three-row grid — a 15px spacer,
                 the thumb, another 15px spacer — around a 20px thumb, so it
                 wants 50px of height. Asking for an 18px-tall slider did not
                 shrink that template, it cropped it: the thumb was clipped to a
                 half circle and the track was squeezed to a hairline. The way
                 to get a compact scrubber is to shrink the parts the template
                 measures, not to squeeze the control around them. -->
            <GridLength x:Key="SliderPreContentMargin">0</GridLength>
            <GridLength x:Key="SliderPostContentMargin">0</GridLength>
            <x:Double x:Key="SliderHorizontalHeight">18</x:Double>
            <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
            <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
            <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>

            <!-- Slider colour: neutral chrome, not brand red. -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#48484A" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#545458" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#545458" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#3A3A3C" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#8E8E93" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#AEAEB2" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#AEAEB2" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#545458" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#636366" />

            <!-- The template paints a plate behind the whole slider on hover.
                 In a transport bar that is a grey rectangle appearing under the
                 scrubber whenever the pointer crosses it. -->
            <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
        </ResourceDictionary>

            <!-- The wash between Now Playing's artwork tones and its controls.
                 Fixed rather than themed: that view is always dark, so this does
                 not follow the palette. Light at the top, where there is only
                 colour to look at, and heavy at the bottom, where the seek bar
                 and the times have to stay readable over a pale record. -->
            <LinearGradientBrush x:Key="PlayerScrim" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#14000000" Offset="0" />
                <GradientStop Color="#4D000000" Offset="0.55" />
                <GradientStop Color="#A6000000" Offset="1" />
            </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
            <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        </Style>

        <!-- Selection, for every list that does not say otherwise.
             Fluent fills the selected row edge to edge with the accent colour.
             Next to album art that is a solid bar of paint across the window,
             and it looks nothing like the sidebar, which marks its current item
             with a quiet raised surface and crimson text. Do the same here: the
             surface carries the selection and the title carries the colour.
             Lists whose rows are only a layout device — the album and artist
             walls — still override this locally to nothing. -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus-within /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock.primary">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <!-- =================================================================
             Hover.

             One rule for everything clickable: it says so under the pointer,
             with a rounded plate that has room around the content, on the frame
             the pointer arrives. No fades — a hover that animates in feels like
             the app is thinking about it, and at the speed a pointer crosses a
             list of songs the fades pile up into a smear.

             The plate lives in the row TEMPLATE, on a Border we own, rather than
             on the ListBoxItem's ContentPresenter — because a list whose rows
             are of mixed kinds cannot style hover at the item level. The detail
             pages put a hero banner, section titles and track rows in ONE
             ListBox, so they switch item hover off wholesale to stop the banner
             lighting up, and that takes the track rows down with it. A plate on
             the track template lights the rows that are rows and nothing else.
             `:pointerover` on the Border needs no selector reaching into a
             theme's template internals, so nothing outside this file can turn it
             off; the transparent resting background is what keeps it
             hit-testable.
             ================================================================= -->
        <Style Selector="Border.rowPlate">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <!-- Even on all four sides, so the gap left of a cover is the gap
                 above it. -->
            <Setter Property="Padding" Value="8" />
            <!-- And a gap, so two rows read as two rows. Without it consecutive
                 plates share an edge, the rounded corners cancel out against
                 each other, and hovering one row looks like a band of colour
                 across the list rather than a card under the pointer. -->
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="Border.rowPlate:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <!-- A tile that is already a raised card lifts its own surface: a plate
             behind a card is a halo at the same colour. -->
        <Style Selector="Border.tileSurface">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="Border.tileSurface:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>

        <!-- The default button.
             Everything below is a variation on this one, and it is written this
             way round because the failure it fixes is a button with NO class on
             it: those fall through to Fluent and arrive with a different height,
             a different corner radius and a different font from every styled
             button beside them. Styling only the classes leaves the default as a
             trap that someone falls into each time a button is added; styling
             the default means forgetting a class produces the right button
             instead of the theme's.

             The metrics are the same ones the role classes use, and the colours
             are `secondary`, because a button with nothing said about it is a
             secondary button. It is declared first so every class after it —
             nav, link, tile, and the roles — still wins.
             ================================================================= -->
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- The resting background, stated rather than inherited.
             Only the hover and selected styles below used to set this, so at
             rest the presenter fell back to the template binding. Navigating
             changes Classes.selected on all seven buttons at once, and while
             that resolves, every one of them briefly painted as though the
             pointer were over it - a flash across the whole sidebar on each
             click. Giving the resting state a value of its own leaves nothing
             to resolve. It must stay above the two styles that follow, which
             are meant to override it. -->
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <!-- The artist and album names in a row stay clickable, but they sit
             inside a plate that already lights up, so a second surface under
             them would read as two overlapping targets. -->
        <Style Selector="Button.link:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- A cover that opens something, where the artwork fills the control
             and a plate around it would have nowhere to go. The affordance is a
             scrim with a chevron over the art itself, which also says WHAT the
             click does — this opens upward into the player — in a way a
             highlight cannot. -->
        <Style Selector="Button.cover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.cover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.cover:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.cover:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.cover:pointerover Border#DockArtworkHover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border#DockArtworkHover">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>

        <Style Selector="Button.tile">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <!-- The padding is not new space: it is the margin each wall used to
                 put BETWEEN its tiles, moved inside the tile, so the hover plate
                 has room to be seen around the art and the footprint is
                 unchanged — which matters because the walls' column counts come
                 from fixed pitch constants in DesktopLayout. -->
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <!-- At rest the artwork is the whole affordance, so the button paints
             nothing; under the pointer a rounded plate appears behind it, and
             the padding is what gives the plate room to be seen around the art
             rather than hiding exactly beneath it. -->
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="Button.tile:focus-visible /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <!-- A tile that is already a raised card lifts that card instead. -->
        <Style Selector="Button.tile.card">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.tile.card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tile.card:focus-visible /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- The base button now paints a pressed state, and a cover must not get
             one behind it: the artwork is the whole affordance. -->
        <Style Selector="Button.tile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tile:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.primary, Button.secondary, Button.ghost, Button.destructive">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDeep}" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.destructive">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.destructive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentHover}" />
        </Style>
        <Style Selector="Button.primary:focus-visible /template/ ContentPresenter,
                         Button.secondary:focus-visible /template/ ContentPresenter,
                         Button.ghost:focus-visible /template/ ContentPresenter,
                         Button.destructive:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <Style Selector="Button.transport">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <!-- Icons bind their Brush to this Foreground; secondary at rest keeps
                 shuffle / repeat / queue / volume quiet so the transport reads as a
                 hierarchy rather than a row of equally loud glyphs. -->
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- The stray blue rounded-rect behind Next was Fluent's
                 DefaultFocusAdorner: the AdornerLayer draws it around whatever last
                 took focus, and clicking a button focuses it. Opt out the same way
                 ComboBox/TextBox do, then supply a keyboard-only ring below so the
                 control stays accessible without the pointer artefact. -->
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <!-- Previous / next lead the secondary controls: full-strength foreground. -->
        <Style Selector="Button.transport.lead">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.transport:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="Button.transport:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        </Style>
        <Style Selector="Button.transport:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- A star is one fifth of a single control, so it carries none of a
             button's chrome: no minimum height, no padding, no plate. Five ghost
             buttons at 36px tall with 16px of side padding read as five separate
             widgets scattered across a line. -->
        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.star:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.star:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.star:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.play">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Style>
        <!-- Press deepens the crimson rather than flashing Fluent's grey pressed fill. -->
        <Style Selector="Button.play:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDeep}" />
        </Style>
        <Style Selector="Button.play:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- The transport, one rung up, for the full player. -->
        <Style Selector="Button.transport.big">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="23" />
        </Style>
        <Style Selector="Button.play.big">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="62" />
            <Setter Property="CornerRadius" Value="31" />
        </Style>
        <!-- The player's play button. Crimson is right on the app's own chrome
             and wrong on the record's colour: over a red album it disappears
             into its own backdrop. White reads on every tone the core can
             produce. -->
        <Style Selector="Button.play.onArtwork">
            <Setter Property="Background" Value="#F2F2F4" />
            <Setter Property="Foreground" Value="#101014" />
        </Style>
        <Style Selector="Button.play.onArtwork:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="TextElement.Foreground" Value="#101014" />
        </Style>
        <Style Selector="Button.play.onArtwork:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#D5D5DC" />
            <Setter Property="TextElement.Foreground" Value="#101014" />
        </Style>


        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.primary">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource SearchBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SurfaceSelected}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SearchBackground}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SearchBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
        </Style>

        <Style Selector="Border.albumArt">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- Slim transport sliders (scrubber + volume) sized for the 88px bar. -->
        <Style Selector="Slider.scrub">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
