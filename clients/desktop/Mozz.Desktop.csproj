<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LibraryImport (the source-generated P/Invoke) emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\mozz.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <Target Name="ComputeMozzVersion" BeforeTargets="GetAssemblyVersion">
    <PropertyGroup>
      <MozzPythonExecutable Condition="'$(MozzPythonExecutable)' == '' and '$(OS)' == 'Windows_NT'">python</MozzPythonExecutable>
      <MozzPythonExecutable Condition="'$(MozzPythonExecutable)' == ''">python3</MozzPythonExecutable>
      <MozzVersionScript>$(MSBuildThisFileDirectory)../../tools/version-info.py</MozzVersionScript>
    </PropertyGroup>
    <Exec
      Command="&quot;$(MozzPythonExecutable)&quot; &quot;$(MozzVersionScript)&quot; --format msbuild-lines"
      ConsoleToMSBuild="true"
      StandardOutputImportance="Low"
      Condition="'$(MozzMarketingVersion)' == '' or '$(MozzBuildNumber)' == '' or '$(MozzDisplayVersion)' == '' or '$(MozzAssemblyVersion)' == '' or '$(MozzFileVersion)' == ''">
      <Output TaskParameter="ConsoleOutput" ItemName="_MozzVersionLine" />
    </Exec>
    <PropertyGroup>
      <_MozzVersionOutput>@(_MozzVersionLine, '|')</_MozzVersionOutput>
      <MozzMarketingVersion Condition="'$(MozzMarketingVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(_MozzVersionOutput)', 'MozzMarketingVersion=([^|]+)').Groups[1].Value)</MozzMarketingVersion>
      <MozzBuildNumber Condition="'$(MozzBuildNumber)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(_MozzVersionOutput)', 'MozzBuildNumber=([^|]+)').Groups[1].Value)</MozzBuildNumber>
      <MozzDisplayVersion Condition="'$(MozzDisplayVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(_MozzVersionOutput)', 'MozzDisplayVersion=([^|]+)').Groups[1].Value)</MozzDisplayVersion>
      <MozzAssemblyVersion Condition="'$(MozzAssemblyVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(_MozzVersionOutput)', 'MozzAssemblyVersion=([^|]+)').Groups[1].Value)</MozzAssemblyVersion>
      <MozzFileVersion Condition="'$(MozzFileVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(_MozzVersionOutput)', 'MozzFileVersion=([^|]+)').Groups[1].Value)</MozzFileVersion>
      <Version>$(MozzMarketingVersion)</Version>
      <AssemblyVersion>$(MozzAssemblyVersion)</AssemblyVersion>
      <FileVersion>$(MozzFileVersion)</FileVersion>
      <InformationalVersion>$(MozzDisplayVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Folder Include="Models\" />
    <!-- Icons.axaml is a XAML ResourceDictionary, not a raw asset: it is already
         picked up as AvaloniaXaml (compiled + embedded), so keep it out of the
         raw-resource glob to avoid including it twice. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Icons.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The runtime behind the generated command client. The command surface is
         described once in schema/ and the Swift and C# clients are generated
         from it, so a capability the schema does not declare cannot be reached
         from either. Generated sources are committed rather than built, so
         protoc is not a prerequisite on any of the four desktop CI targets —
         see tools/generate-schema.sh and ADR-0016. -->
    <PackageReference Include="Google.Protobuf" Version="3.33.1" />
    <!-- miniaudio (MIT / public-domain) as the cross-platform output device.
         Ships prebuilt natives for win-x64/arm64/x86, osx-x64/arm64 and
         linux-x64/arm64, so the audio device works on every target with no
         extra toolchain. Decode and HTTP go through the system FFmpeg binary. -->
    <PackageReference Include="Hexa.NET.MiniAudio" Version="1.0.1" />
  </ItemGroup>
</Project>
