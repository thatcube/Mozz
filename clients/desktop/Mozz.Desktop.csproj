<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LibraryImport (the source-generated P/Invoke) emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\mozz.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <!-- Icons.axaml is a XAML ResourceDictionary, not a raw asset: it is already
         picked up as AvaloniaXaml (compiled + embedded), so keep it out of the
         raw-resource glob to avoid including it twice. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Icons.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- miniaudio (MIT / public-domain) as the cross-platform output device.
         Ships prebuilt natives for win-x64/arm64/x86, osx-x64/arm64 and
         linux-x64/arm64, so the audio device works on every target with no
         extra toolchain. Decode and HTTP go through the system FFmpeg binary. -->
    <PackageReference Include="Hexa.NET.MiniAudio" Version="1.0.1" />
  </ItemGroup>
</Project>
