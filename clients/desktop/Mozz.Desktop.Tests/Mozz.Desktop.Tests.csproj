<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Source files are included directly rather than through a ProjectReference.

    The app is a WinExe with a full Avalonia dependency tree; the things worth
    testing here are the platform-native credential store and the pure request
    shaping, neither of which needs a UI framework. Pulling Avalonia into a
    headless test run buys nothing and makes the run fragile on a CI machine
    with no display.
  -->
  <ItemGroup>
    <Compile Include="..\Core\SecretStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
