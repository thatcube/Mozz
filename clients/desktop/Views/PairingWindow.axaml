<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mozz.Desktop.ViewModels"
        x:Class="Mozz.Desktop.Views.PairingWindow"
        x:DataType="vm:PairingViewModel"
        Title="Pair a Device"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner">

  <Border Padding="24">
    <StackPanel Spacing="16">

      <TextBlock Text="Pair a Device"
                 FontSize="22" FontWeight="SemiBold" />

      <TextBlock Text="{Binding Status}"
                 TextWrapping="Wrap"
                 Opacity="0.75" />

      <!-- Devices found advertising _mozz._tcp -->
      <StackPanel Spacing="6">
        <TextBlock Text="Devices nearby" FontWeight="SemiBold" />
        <ListBox ItemsSource="{Binding Devices}"
                 SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                 SelectionMode="Single"
                 Height="110">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="1" Margin="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Opacity="0.6" FontSize="11">
                  <Run Text="{Binding Address}" /><Run Text=":" /><Run Text="{Binding Port}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- Optional. Left in because pasting a code skips the digit comparison
           entirely, but the digit path is the normal way to pair a desktop:
           the QR payload is sixty characters of base64 and asking anyone to
           retype it would be absurd. -->
      <Expander Header="Have a code to paste? (optional)">
        <TextBox Text="{Binding Code}"
                 PlaceholderText="MOZZ1:…"
                 AcceptsReturn="False"
                 Margin="0,8,0,0"
                 FontFamily="monospace" />
      </Expander>

      <!-- Digit comparison, only on the digit path -->
      <Border IsVisible="{Binding IsComparing}"
              Background="#20808080"
              CornerRadius="8"
              Padding="16">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <TextBlock Text="{Binding Digits}"
                     FontSize="30"
                     FontFamily="monospace"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Both devices should show this number."
                     Opacity="0.7" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="They match" Command="{Binding MatchesCommand}" />
            <Button Content="They do not match" Command="{Binding DoesNotMatchCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Pair"
                Command="{Binding PairCommand}"
                IsEnabled="{Binding CanPair}"
                IsDefault="True" />
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     Width="120" VerticalAlignment="Center" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
