<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mozz.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="Mozz.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource AppBackground}"
        TransparencyLevelHint="AcrylicBlur"
        Title="Mozz">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!--
      Three bands, the shape every desktop music player converges on because it
      works: a sidebar that never moves, a content area that scrolls, and a
      now-playing bar pinned to the bottom so transport is always one click away
      regardless of how deep you've browsed.
    -->
    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="240,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12,16,12,12">

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="8,0,0,18">
                        <Border Width="26" Height="26" CornerRadius="6"
                                Background="{DynamicResource AccentDeep}" />
                        <TextBlock Text="Mozz" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText}"
                             Watermark="Search"
                             Margin="0,0,0,16"
                             CornerRadius="7"
                             FontSize="13"
                             Background="{DynamicResource SurfaceRaised}"
                             BorderThickness="0"
                             Padding="10,8" />

                    <StackPanel Grid.Row="2" Spacing="2">
                        <Button Classes="nav" Content="Home"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Home}" />
                        <Button Classes="nav" Content="Songs"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Songs}" />
                        <Button Classes="nav" Content="Albums"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Albums}" />
                        <Button Classes="nav" Content="Artists"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Artists}" />
                        <Button Classes="nav" Content="Playlists"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Playlists}" />
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Text="{Binding LibrarySummary}"
                               Classes="secondary"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="8,12,8,4" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="28,22,20,0">

                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,18">
                    <TextBlock Text="{Binding PageTitle}" Classes="pageTitle" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="secondary"
                               IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <Panel Grid.Row="1">

                    <!-- Empty state -->
                    <StackPanel IsVisible="{Binding IsLibraryEmpty}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="10" MaxWidth="420">
                        <TextBlock Text="Nothing here yet" Classes="sectionTitle"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Connect a Plex, Jellyfin or Subsonic server and Mozz will sync your library. Set MOZZ_LIBRARY to point at an existing one." />
                    </StackPanel>

                    <!-- Songs / search results -->
                    <ScrollViewer IsVisible="{Binding ShowTracks}">
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="trackRow" Margin="0,1">
                                        <Grid ColumnDefinitions="40,*,180,60" Height="46">
                                            <Border Grid.Column="0" Classes="albumArt"
                                                    Width="34" Height="34" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Margin="12,0" Spacing="1">
                                                <TextBlock Text="{Binding Title}" Classes="primary" />
                                                <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding AlbumTitle}"
                                                       Classes="secondary" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Duration}"
                                                       Classes="secondary" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" Margin="0,0,8,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Albums -->
                    <ScrollViewer IsVisible="{Binding ShowAlbums}">
                        <ItemsControl ItemsSource="{Binding Albums}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="168" Margin="0,0,18,22" Spacing="8">
                                        <Border Classes="albumArt" Width="168" Height="168" />
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Title}" Classes="primary" />
                                            <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Artists -->
                    <ScrollViewer IsVisible="{Binding ShowArtists}">
                        <ItemsControl ItemsSource="{Binding Artists}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="150" Margin="0,0,18,22" Spacing="8"
                                                HorizontalAlignment="Center">
                                        <Border Width="130" Height="130" CornerRadius="65"
                                                Background="{DynamicResource SurfaceRaised}"
                                                HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Classes="primary"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </Grid>
        </Grid>

        <!-- Now playing -->
        <Border Grid.Row="1" Height="84"
                Background="{DynamicResource BarBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,*" Margin="20,0">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <Border Classes="albumArt" Width="54" Height="54" />
                    <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="260">
                        <TextBlock Classes="primary" FontWeight="Medium"
                                   Text="{Binding NowPlaying.Title, FallbackValue='Not playing'}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding NowPlaying.ArtistName, FallbackValue=''}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center">
                        <Button Classes="transport" Content="⇄" FontSize="15" />
                        <Button Classes="transport" Content="◀◀" FontSize="13" />
                        <Button Classes="play" Content="▶" FontSize="15"
                                Command="{Binding TogglePlayPauseCommand}" />
                        <Button Classes="transport" Content="▶▶" FontSize="13" />
                        <Button Classes="transport" Content="↻" FontSize="15" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                        <TextBlock Text="0:00" Classes="secondary" FontSize="11"
                                   VerticalAlignment="Center" />
                        <Border Width="380" Height="4" CornerRadius="2"
                                Background="{DynamicResource SurfaceHover}"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NowPlaying.Duration, FallbackValue='0:00'}"
                                   Classes="secondary" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="transport" Content="☰" FontSize="14" />
                    <Button Classes="transport" Content="🔊" FontSize="13" />
                    <Border Width="90" Height="4" CornerRadius="2"
                            Background="{DynamicResource SurfaceHover}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
