<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mozz.Desktop.ViewModels"
        xmlns:core="using:Mozz.Desktop.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="880"
        x:Class="Mozz.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1360" Height="880"
        MinWidth="940" MinHeight="620"
        Background="{DynamicResource AppBackground}"
        Title="Mozz">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <core:ArtworkPlaceholderConverter x:Key="Artwork" />
        <core:InitialConverter x:Key="Initial" />
    </Window.Resources>

    <!--
      Three bands, the arrangement every desktop player converges on because it
      works: a sidebar that never moves, content that scrolls, and transport
      pinned to the bottom so it stays reachable however deep you've browsed.
    -->
    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="248,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14,18,14,14">

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="6,0,0,20">
                        <Border Width="28" Height="28" CornerRadius="7"
                                Background="{DynamicResource AccentDeep}">
                            <TextBlock Text="M" FontSize="16" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Mozz" FontSize="21" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText}"
                             PlaceholderText="Search your library"
                             Margin="0,0,0,18"
                             CornerRadius="8"
                             FontSize="13"
                             Background="{DynamicResource SurfaceRaised}"
                             BorderThickness="0"
                             Padding="11,9" />

                    <StackPanel Grid.Row="2" Spacing="3">
                        <Button Classes="nav" Classes.selected="{Binding IsHomeSelected}"
                                Content="Home"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Home}" />
                        <Button Classes="nav" Classes.selected="{Binding IsSongsSelected}"
                                Content="Songs"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Songs}" />
                        <Button Classes="nav" Classes.selected="{Binding IsAlbumsSelected}"
                                Content="Albums"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Albums}" />
                        <Button Classes="nav" Classes.selected="{Binding IsArtistsSelected}"
                                Content="Artists"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Artists}" />
                        <Button Classes="nav" Classes.selected="{Binding IsPlaylistsSelected}"
                                Content="Playlists"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Playlists}" />
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Text="{Binding LibrarySummary}"
                               Classes="secondary"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="6,12,6,4" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="32,26,24,0">

                <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
                    <TextBlock Text="{Binding PageTitle}" Classes="pageTitle" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="secondary"
                               IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <Panel Grid.Row="1">

                    <StackPanel IsVisible="{Binding IsLibraryEmpty}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="11" MaxWidth="430">
                        <TextBlock Text="Nothing here yet" Classes="sectionTitle"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Connect a Plex, Jellyfin or Subsonic server and Mozz will sync your library." />
                    </StackPanel>

                    <!-- Songs / search results.
                         ListBox rather than ItemsControl: it virtualizes, which is
                         what keeps a hundred thousand rows scrolling smoothly. -->
                    <ListBox IsVisible="{Binding ShowTracks}"
                             x:Name="TracksList"
                             ItemsSource="{Binding Tracks}"
                             DoubleTapped="OnTrackActivated"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="44,*,200,64" Height="50">
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="6" ClipToBounds="True"
                                            Background="{Binding AlbumTitle, Converter={StaticResource Artwork}}">
                                        <TextBlock Text="{Binding AlbumTitle, Converter={StaticResource Initial}}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#88FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Margin="13,0" Spacing="2">
                                        <TextBlock Text="{Binding Title}" Classes="primary" />
                                        <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding AlbumTitle}"
                                               Classes="secondary" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}"
                                               Classes="secondary" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="0,0,10,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Albums -->
                    <ScrollViewer IsVisible="{Binding ShowAlbums}">
                        <ItemsControl ItemsSource="{Binding Albums}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="176" Margin="0,0,20,24" Spacing="9">
                                        <Border Width="176" Height="176" CornerRadius="8"
                                                ClipToBounds="True"
                                                Background="{Binding Title, Converter={StaticResource Artwork}}">
                                            <TextBlock Text="{Binding Title, Converter={StaticResource Initial}}"
                                                       FontSize="52" FontWeight="Bold"
                                                       Foreground="#55FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" Classes="primary" />
                                            <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Artists -->
                    <ScrollViewer IsVisible="{Binding ShowArtists}">
                        <ItemsControl ItemsSource="{Binding Artists}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="158" Margin="0,0,20,24" Spacing="10">
                                        <Border Width="138" Height="138" CornerRadius="69"
                                                ClipToBounds="True"
                                                HorizontalAlignment="Center"
                                                Background="{Binding Name, Converter={StaticResource Artwork}}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}"
                                                       FontSize="44" FontWeight="Bold"
                                                       Foreground="#55FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Classes="primary"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </Grid>
        </Grid>

        <!-- Now playing -->
        <Border Grid.Row="1" Height="88"
                Background="{DynamicResource BarBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,*" Margin="22,0">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="13"
                            VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="7" ClipToBounds="True"
                            Background="{Binding NowPlaying.AlbumTitle, Converter={StaticResource Artwork}}">
                        <TextBlock Text="{Binding NowPlaying.AlbumTitle, Converter={StaticResource Initial}}"
                                   FontSize="20" FontWeight="SemiBold" Foreground="#66FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="3" MaxWidth="270">
                        <TextBlock Classes="primary" FontWeight="Medium"
                                   Text="{Binding NowPlaying.Title, FallbackValue='Not playing'}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding NowPlaying.ArtistName, FallbackValue=''}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="11" HorizontalAlignment="Center">
                        <Button Classes="transport" Content="⤨" FontSize="15" />
                        <Button Classes="transport" Content="⏮" FontSize="15"
                                Command="{Binding PreviousCommand}" />
                        <Button Classes="play" Content="{Binding PlayPauseGlyph}" FontSize="17"
                                Command="{Binding TogglePlayPauseCommand}" />
                        <Button Classes="transport" Content="⏭" FontSize="15"
                                Command="{Binding NextCommand}" />
                        <Button Classes="transport" Content="⟳" FontSize="15" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PositionText, FallbackValue='0:00'}" Classes="secondary" FontSize="11"
                                   VerticalAlignment="Center" />
                        <Slider Classes="scrub" Width="420" Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DurationText, FallbackValue='0:00'}"
                                   Classes="secondary" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="transport" Content="☰" FontSize="14" />
                    <Button Classes="transport" Content="🔉" FontSize="13" />
                    <Slider Classes="scrub" Width="96" Minimum="0" Maximum="1"
                            Value="{Binding Volume, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
