<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mozz.Desktop.ViewModels"
        xmlns:core="using:Mozz.Desktop.Core"
        xmlns:controls="using:Mozz.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="880"
        x:Class="Mozz.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1360" Height="880"
        MinWidth="390" MinHeight="620"
        Background="{DynamicResource AppBackground}"
        Title="Mozz"
        Icon="avares://Mozz.Desktop/Assets/mozz.ico"
        SizeChanged="OnWindowResized">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <core:EnumMatchConverter x:Key="EnumMatch" />
        <core:StringMatchConverter x:Key="StringMatch" />
        <core:PendingOpacityConverter x:Key="PendingOpacity" />
        <core:RatingAtLeastConverter x:Key="RatingAtLeast" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Window.medium Grid.contentShell">
            <Setter Property="Margin" Value="24,22,20,0" />
        </Style>
        <Style Selector="Window.compact Grid.contentShell">
            <Setter Property="Margin" Value="14,18,14,0" />
        </Style>
        <Style Selector="Window.compact TextBlock.pageTitle">
            <Setter Property="FontSize" Value="24" />
        </Style>
        <!-- The Home mix tile is wider than a phone-width content pane. It keeps
             its two-cell rhythm but yields width before the row can clip. -->
        <Style Selector="Button.homeMixTile">
            <Setter Property="Width" Value="410" />
        </Style>
        <Style Selector="Window.compact Button.homeMixTile">
            <Setter Property="Width" Value="330" />
        </Style>
        <Style Selector="TextBlock.compactOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.compact TextBlock.compactOnly">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- Compact track rows keep the playable identity and the actions. The
             album column is secondary at this width and is the column that would
             otherwise squeeze the title to nothing. -->
        <Style Selector="Window.compact Button.trackAlbumColumn,
                         Window.compact Button.playlistArtistColumn,
                         Window.compact Button.playlistAlbumColumn,
                         Window.compact Button.queueArtistColumn,
                         Window.compact Button.queueAlbumColumn,
                         Window.compact TextBlock.compactHidden">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.detailHeroText">
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style Selector="Window.compact StackPanel.detailHeroText,
                         Window.compact StackPanel.nowPlayingText">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style Selector="StackPanel.artistHeroChrome">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="12" />
        </Style>
        <Style Selector="Window.compact StackPanel.artistHeroChrome">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Spacing" Value="8" />
        </Style>
    </Window.Styles>

    <!--
      Three bands, the arrangement every desktop player converges on because it
      works: a sidebar that never moves, content that scrolls, and transport
      pinned to the bottom so it stays reachable however deep you've browsed.
    -->
    <Grid x:Name="RootGrid" RowDefinitions="*,Auto">

        <Grid x:Name="MainContentGrid" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="SidebarPane" Grid.Column="0" Background="{DynamicResource SidebarBackground}">
                <Grid x:Name="SidebarInterior" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="14,18,14,14">

                    <StackPanel x:Name="SidebarHeader" Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="6,0,0,20">
                        <!-- The actual app icon, not a letter in a box. The art
                             is a pixel-art disc with transparent corners, so it
                             needs no rounded plate behind it. -->
                        <Image Source="avares://Mozz.Desktop/Assets/mozz.png"
                               Width="28" Height="28"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock x:Name="SidebarTitle" Text="Mozz" FontSize="21" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox x:Name="SidebarSearch" Grid.Row="1"
                             Text="{Binding SearchText}"
                             PlaceholderText="Search your library"
                             Margin="0,0,0,18"
                             CornerRadius="8"
                             FontSize="13"
                             Background="{DynamicResource SearchBackground}"
                             BorderThickness="0"
                             Padding="4,9,11,9">
                        <TextBox.InnerLeftContent>
                            <controls:TablerIcon Size="16" Data="{StaticResource IconSearch}"
                                                 Brush="{DynamicResource TextTertiary}"
                                                 Margin="10,0,4,0" VerticalAlignment="Center" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <StackPanel Grid.Row="2" Spacing="3">
                        <Button x:Name="NavHome" Classes="nav" Classes.selected="{Binding IsHomeSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Home}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconHome}"
                                                     Brush="{Binding #LblHome.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblHome" Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSongs" Classes="nav" Classes.selected="{Binding IsSongsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Songs}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconMusic}"
                                                     Brush="{Binding #LblSongs.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblSongs" Text="Songs" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAlbums" Classes="nav" Classes.selected="{Binding IsAlbumsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Albums}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconDisc}"
                                                     Brush="{Binding #LblAlbums.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblAlbums" Text="Albums" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavArtists" Classes="nav" Classes.selected="{Binding IsArtistsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Artists}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconArtist}"
                                                     Brush="{Binding #LblArtists.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblArtists" Text="Artists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavGenres" Classes="nav" Classes.selected="{Binding IsGenresSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Genres}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconStack}"
                                                     Brush="{Binding #LblGenres.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblGenres" Text="Genres" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavPlaylists" Classes="nav" Classes.selected="{Binding IsPlaylistsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Playlists}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconPlaylist}"
                                                     Brush="{Binding #LblPlaylists.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblPlaylists" Text="Playlists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDownloads" Classes="nav" Classes.selected="{Binding IsDownloadsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Downloads}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconDownload}"
                                                     Brush="{Binding #LblDownloads.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblDownloads" Text="Downloads" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border x:Name="SidebarLibraryCard" Grid.Row="3" Background="{DynamicResource SurfaceRaised}"
                            CornerRadius="11" Padding="12" VerticalAlignment="Bottom"
                            Margin="0,14,0,12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Library" Classes="secondary" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LibrarySummary}" Classes="primary" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="NavSettings" Grid.Row="4" Classes="nav" Classes.selected="{Binding IsSettingsSelected}"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="{x:Static vm:LibrarySection.Settings}">
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="11">
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                    Background="{DynamicResource SurfaceRaised}"
                                    ClipToBounds="True">
                                <Panel>
                                    <controls:ArtworkImage Width="30" Height="30" DisplaySize="30"
                                            CornerRadius="15"
                                            ImageUrl="{Binding ActiveAccountAvatarUrl}"
                                            FallbackText="{Binding ActiveAccountFallbackText}"
                                            FallbackFontSize="12"
                                            FallbackFontWeight="SemiBold"
                                            FallbackForeground="{DynamicResource ArtworkFallbackPrimary}"
                                            IsVisible="{Binding HasActiveAccountAvatar}" />
                                    <controls:TablerIcon Size="18" Data="{StaticResource IconArtist}"
                                                         Brush="{Binding #LblProfile.Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         IsVisible="{Binding !HasActiveAccountAvatar}" />
                                </Panel>
                            </Border>
                            <StackPanel x:Name="SidebarProfileText" Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LblProfile" Text="{Binding SidebarProfileTitle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SidebarProfileSubtitle}" Classes="secondary" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="32,26,24,116" Classes="contentShell">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,20">
                    <Button x:Name="CompactNavigationButton" Grid.Column="0" Classes="transport"
                            Margin="0,0,12,0"
                            IsVisible="False"
                            Click="OnCompactNavigationButtonClicked">
                        <controls:TablerIcon Size="19" Data="{StaticResource IconQueue}"
                                            Brush="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button Grid.Column="1" Classes="transport"
                            Margin="0,0,12,0"
                            IsVisible="{Binding CanGoBack}"
                            Command="{Binding GoBackCommand}">
                        <controls:TablerIcon Size="19" Data="{StaticResource IconChevronLeft}"
                                             Brush="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Text="{Binding PageTitle}" Classes="pageTitle" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="secondary"
                               IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Grid>

                <Panel Grid.Row="1" x:Name="ContentPane" SizeChanged="OnContentResized">

                    <StackPanel IsVisible="{Binding IsLibraryEmpty}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="11" MaxWidth="430">
                        <TextBlock Text="Nothing here yet" Classes="sectionTitle"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Connect a Plex, Jellyfin or Subsonic server and Mozz will sync your library." />
                        <Button Content="Connect a server"
                                HorizontalAlignment="Center"
                                Classes="primary"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Settings}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowHomeEmpty}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="11" MaxWidth="430">
                        <TextBlock Text="No mixes yet" Classes="sectionTitle"
                                  HorizontalAlignment="Center" />
                        <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                                  Text="Play more music and Mozz will build Home from your listening history." />
                    </StackPanel>

                    <!-- Home. A ListBox of rows keeps the mixes grid and every
                         shelf virtualized; each row realizes only the few cards
                         that fit across the current window. -->
                    <ListBox IsVisible="{Binding ShowHomeRows}"
                             ItemsSource="{Binding HomeRows}"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:HomeMixGridRow">
                                <ItemsControl ItemsSource="{Binding Mixes}">
                                   <ItemsControl.ItemsPanel>
                                       <ItemsPanelTemplate>
                                           <StackPanel Orientation="Horizontal" />
                                       </ItemsPanelTemplate>
                                   </ItemsControl.ItemsPanel>
                                   <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                           <Button Classes="tile homeMixTile" Margin="0,0,20,16"
                                                   Command="{Binding $parent[Window].DataContext.OpenMixCommand}"
                                                   CommandParameter="{Binding}">
                                               <Border Background="{DynamicResource SurfaceRaised}"
                                                       CornerRadius="12" ClipToBounds="True">
                                                   <Grid ColumnDefinitions="88,*" Height="88">
                                                       <Border Grid.Column="0" Width="88" Height="88"
                                                               Background="{DynamicResource Accent}"
                                                               IsVisible="{Binding IsLiked}">
                                                           <controls:TablerIcon Size="30" Filled="True"
                                                                                Data="{StaticResource IconHeart}"
                                                                                Brush="{DynamicResource BrandForeground}"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                       </Border>
                                                       <controls:ArtworkImage Grid.Column="0"
                                                               Width="88" Height="88" DisplaySize="88"
                                                               CornerRadius="0"
                                                               ServerId="{Binding ServerId}"
                                                               ArtworkKey="{Binding ArtworkKey}"
                                                               FallbackText="{Binding FallbackText}"
                                                               FallbackFontSize="24"
                                                               FallbackFontWeight="SemiBold"
                                                               FallbackForeground="{DynamicResource ArtworkFallbackPrimary}"
                                                               IsVisible="{Binding !IsLiked}" />
                                                       <StackPanel Grid.Column="1" Spacing="4"
                                                                   VerticalAlignment="Center" Margin="18,0,16,0">
                                                           <TextBlock Text="{Binding Title}" Classes="primary"
                                                                      FontSize="22" FontWeight="SemiBold" />
                                                           <TextBlock Text="{Binding Subtitle}" Classes="secondary"
                                                                      FontSize="15"
                                                                      IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                       </StackPanel>
                                                   </Grid>
                                               </Border>
                                           </Button>
                                       </DataTemplate>
                                   </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:HomeMessageRow">
                                <Border Background="{DynamicResource SurfaceRaised}"
                                        CornerRadius="12" Padding="18" Margin="0,0,20,16">
                                    <TextBlock Text="{Binding Message}" Classes="secondary" />
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:HomeSectionTitleRow">
                                <TextBlock Text="{Binding Title}" Classes="sectionTitle" Margin="0,10,0,12" />
                            </DataTemplate>

                            <DataTemplate DataType="vm:HomeTrackShelfRow">
                                <ItemsControl ItemsSource="{Binding Tracks}">
                                   <ItemsControl.ItemsPanel>
                                       <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                   </ItemsControl.ItemsPanel>
                                   <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                           <Button Classes="tile" Command="{Binding $parent[Window].DataContext.PlayHomeTrackCommand}"
                                                   CommandParameter="{Binding}">
                                               <Border Width="300" Margin="0,0,20,12" Padding="8" CornerRadius="8"
                                                       Background="{DynamicResource SurfaceRaised}">
                                                   <Grid ColumnDefinitions="44,*,38,64" Height="44">
                                                       <controls:ArtworkImage Grid.Column="0" Width="40" Height="40" DisplaySize="40" CornerRadius="6"
                                                               ServerId="{Binding Track.ServerId}" ArtworkKey="{Binding Track.ArtworkKey}"
                                                               FallbackText="{Binding Track.AlbumTitle}" FallbackFontSize="15" FallbackForeground="{DynamicResource ArtworkFallbackSecondary}" />
                                                       <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                                           <TextBlock Text="{Binding Track.Title}" Classes="primary" />
                                                           <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                                                       </StackPanel>
                                                       <Button Grid.Column="2" Classes="ghost" Width="32" Height="32"
                                                               Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}"
                                                               CommandParameter="{Binding Track}"
                                                               ToolTip.Tip="{Binding Track.FavoriteLabel}">
                                                           <Panel Opacity="{Binding Track.FavoritePending, Converter={StaticResource PendingOpacity}}">
                                                               <controls:TablerIcon Size="16" Filled="True" Data="{StaticResource IconHeart}"
                                                                                    Brush="{DynamicResource BrandForeground}" IsVisible="{Binding Track.IsFavorite}" />
                                                               <controls:TablerIcon Size="16" Data="{StaticResource IconHeartOutline}"
                                                                                    Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding !Track.IsFavorite}" />
                                                           </Panel>
                                                       </Button>
                                                       <TextBlock Grid.Column="3" Text="{Binding Track.Duration}" Classes="secondary"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                   </Grid>
                                               </Border>
                                           </Button>
                                       </DataTemplate>
                                   </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:HomeAlbumShelfRow">
                                <ItemsControl ItemsSource="{Binding Albums}">
                                   <ItemsControl.ItemsPanel>
                                       <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                   </ItemsControl.ItemsPanel>
                                   <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                           <Button Classes="tile" Width="196" Margin="0,0,0,2"
                                                   Command="{Binding $parent[Window].DataContext.OpenAlbumCommand}"
                                                   CommandParameter="{Binding}">
                                               <StackPanel Spacing="9">
                                                   <controls:ArtworkImage Width="176" Height="176" DisplaySize="176" CornerRadius="8"
                                                           ServerId="{Binding ServerId}" ArtworkKey="{Binding ArtworkKey}"
                                                           FallbackText="{Binding Title}" FallbackFontSize="52" FallbackForeground="{DynamicResource ArtworkFallbackTertiary}" />
                                                   <StackPanel Spacing="2">
                                                       <TextBlock Text="{Binding Title}" Classes="primary" />
                                                       <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                                   </StackPanel>
                                               </StackPanel>
                                           </Button>
                                       </DataTemplate>
                                   </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:HomePlaylistShelfRow">
                                <ItemsControl ItemsSource="{Binding Playlists}">
                                   <ItemsControl.ItemsPanel>
                                       <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                   </ItemsControl.ItemsPanel>
                                   <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                           <Button Classes="tile card" Width="216" Margin="0,0,20,22"
                                                   Command="{Binding $parent[Window].DataContext.OpenPlaylistCommand}"
                                                   CommandParameter="{Binding}">
                                               <Border Classes="tileSurface" CornerRadius="12" Padding="18" Height="148">
                                                   <StackPanel Spacing="8" VerticalAlignment="Center">
                                                       <controls:TablerIcon Size="32" Data="{StaticResource IconPlaylist}"
                                                                            Brush="{DynamicResource TextSecondary}" />
                                                       <TextBlock Text="{Binding Title}" Classes="primary" FontSize="16" />
                                                       <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} songs'}"
                                                                  Classes="secondary" />
                                                   </StackPanel>
                                               </Border>
                                           </Button>
                                       </DataTemplate>
                                   </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>

                    <!-- Songs / search results.
                         ListBox rather than ItemsControl: it virtualizes, which is
                         what keeps a hundred thousand rows scrolling smoothly. -->
                    <ListBox IsVisible="{Binding ShowTracks}"
                             x:Name="TracksList"
                             ItemsSource="{Binding Tracks}"
                             DoubleTapped="OnTrackActivated"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="rowPlate">
                                    <Grid ColumnDefinitions="40,*,Auto,Auto,Auto" Height="40" Classes="libraryTrackRow">
                                        <controls:ArtworkImage Grid.Column="0"
                                                Width="40" Height="40" DisplaySize="40"
                                                CornerRadius="6"
                                                ServerId="{Binding ServerId}"
                                                ArtworkKey="{Binding ArtworkKey}"
                                                FallbackText="{Binding AlbumTitle}"
                                                FallbackFontSize="15"
                                                FallbackFontWeight="SemiBold"
                                                FallbackForeground="{DynamicResource ArtworkFallbackSecondary}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="13,0" Spacing="1">
                                            <TextBlock Text="{Binding Title}" Classes="primary" />
                                            <Button Classes="link"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding $parent[Window].DataContext.OpenTrackArtistCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                            </Button>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="link trackAlbumColumn" Width="200"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[Window].DataContext.OpenTrackAlbumCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding AlbumTitle}" Classes="secondary" />
                                        </Button>
                                        <Button Grid.Column="3" Classes="ghost trackFavoriteColumn" Width="34" Height="34"
                                                Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding FavoriteLabel}">
                                            <Panel Opacity="{Binding FavoritePending, Converter={StaticResource PendingOpacity}}">
                                                <controls:TablerIcon Size="17" Filled="True" Data="{StaticResource IconHeart}"
                                                                     Brush="{DynamicResource BrandForeground}" IsVisible="{Binding IsFavorite}" />
                                                <controls:TablerIcon Size="17" Data="{StaticResource IconHeartOutline}"
                                                                     Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding !IsFavorite}" />
                                            </Panel>
                                        </Button>
                                        <TextBlock Grid.Column="4" Classes="secondary trackDurationColumn" Text="{Binding Duration}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="0,0,10,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Albums -->
                    <!-- Albums.
                         A ListBox of ROWS, not a WrapPanel of tiles: Avalonia has
                         only VirtualizingStackPanel, so chunking into rows is what
                         buys virtualization. See ViewModels/GridRows.cs. -->
                    <ListBox IsVisible="{Binding ShowAlbums}"
                             ItemsSource="{Binding AlbumGrid.Rows}"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <!-- A row is a layout device, not something to select.
                                 Without these the ListBox paints its selected and
                                 hover chrome across a whole row of tiles, which
                                 reads as a rendering fault. -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile" Width="196" Margin="0,0,0,4"
                                                    Command="{Binding $parent[Window].DataContext.OpenAlbumCommand}"
                                                    CommandParameter="{Binding}">
                                            <StackPanel Spacing="9">
                                                <controls:ArtworkImage
                                                        Width="176" Height="176" DisplaySize="176"
                                                        CornerRadius="8"
                                                        ServerId="{Binding ServerId}"
                                                        ArtworkKey="{Binding ArtworkKey}"
                                                        FallbackText="{Binding Title}"
                                                        FallbackFontSize="52"
                                                        FallbackForeground="{DynamicResource ArtworkFallbackTertiary}" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}" Classes="primary" />
                                                    <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                                </StackPanel>
                                            </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Artists -->
                    <ListBox IsVisible="{Binding ShowArtists}"
                             ItemsSource="{Binding ArtistGrid.Rows}"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <!-- A row is a layout device, not something to select.
                                 Without these the ListBox paints its selected and
                                 hover chrome across a whole row of tiles, which
                                 reads as a rendering fault. -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile" Width="178" Margin="0,0,0,4"
                                                    Command="{Binding $parent[Window].DataContext.OpenArtistCommand}"
                                                    CommandParameter="{Binding}">
                                            <StackPanel Spacing="10">
                                                <controls:ArtworkImage
                                                        Width="138" Height="138" DisplaySize="138"
                                                        CornerRadius="69"
                                                        HorizontalAlignment="Center"
                                                        ServerId="{Binding ServerId}"
                                                        ArtworkKey="{Binding ArtworkKey}"
                                                        FallbackText="{Binding Name}"
                                                        FallbackFontSize="44"
                                                        FallbackForeground="{DynamicResource ArtworkFallbackTertiary}" />
                                                <TextBlock Text="{Binding Name}" Classes="primary"
                                                           TextAlignment="Center" />
                                            </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Genres -->
                    <ListBox IsVisible="{Binding ShowGenres}"
                             ItemsSource="{Binding GenreGrid.Rows}"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile card" Width="216" Margin="0,0,20,24"
                                                    Command="{Binding $parent[Window].DataContext.OpenGenreCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Classes="tileSurface" CornerRadius="12" Padding="18" Height="128">
                                                    <StackPanel Spacing="8" VerticalAlignment="Center">
                                                        <controls:TablerIcon Size="32" Data="{StaticResource IconStack}"
                                                                             Brush="{DynamicResource TextSecondary}" />
                                                        <TextBlock Text="{Binding Name}" Classes="primary" FontSize="17" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Search: compact result groups. Each item pushes onto the
                         same navigation stack as the library walls. -->
                    <ListBox IsVisible="{Binding ShowSearch}"
                             ItemsSource="{Binding SearchRows}"
                             DoubleTapped="OnSearchRowActivated"
                             Background="Transparent" BorderThickness="0"
                             Padding="0,0,8,24">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:SearchHeaderRow">
                                <TextBlock Text="{Binding Title}" Classes="sectionTitle" Margin="0,18,0,10" />
                            </DataTemplate>
                            <DataTemplate DataType="vm:SearchEmptyRow">
                                <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="18" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Message}" Classes="secondary" />
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:SearchTrackRow">
                                <Border Classes="rowPlate">
                                    <Grid ColumnDefinitions="40,*,Auto,Auto,Auto" Height="40" Classes="libraryTrackRow">
                                        <controls:ArtworkImage Grid.Column="0" Width="40" Height="40" DisplaySize="40" CornerRadius="6"
                                                ServerId="{Binding Track.ServerId}" ArtworkKey="{Binding Track.ArtworkKey}"
                                                FallbackText="{Binding Track.AlbumTitle}" FallbackFontSize="15" FallbackForeground="{DynamicResource ArtworkFallbackSecondary}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0" Spacing="1">
                                            <TextBlock Text="{Binding Track.Title}" Classes="primary" />
                                            <Button Classes="link" HorizontalAlignment="Left"
                                                    Command="{Binding $parent[Window].DataContext.OpenTrackArtistCommand}"
                                                    CommandParameter="{Binding Track}">
                                                <TextBlock Text="{Binding Track.ArtistName}" Classes="secondary compactOnly" />
                                            </Button>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="link trackAlbumColumn" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Command="{Binding $parent[Window].DataContext.OpenTrackAlbumCommand}"
                                                CommandParameter="{Binding Track}">
                                            <TextBlock Text="{Binding Track.AlbumTitle}" Classes="secondary" />
                                        </Button>
                                        <Button Grid.Column="3" Classes="ghost trackFavoriteColumn" Width="34" Height="34"
                                                Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding Track}"
                                                ToolTip.Tip="{Binding Track.FavoriteLabel}">
                                            <Panel Opacity="{Binding Track.FavoritePending, Converter={StaticResource PendingOpacity}}">
                                                <controls:TablerIcon Size="17" Filled="True" Data="{StaticResource IconHeart}"
                                                                     Brush="{DynamicResource BrandForeground}" IsVisible="{Binding Track.IsFavorite}" />
                                                <controls:TablerIcon Size="17" Data="{StaticResource IconHeartOutline}"
                                                                     Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding !Track.IsFavorite}" />
                                            </Panel>
                                        </Button>
                                        <TextBlock Grid.Column="4" Text="{Binding Track.Duration}" Classes="secondary trackDurationColumn"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:SearchAlbumRow">
                                <Button Classes="tile" HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[Window].DataContext.OpenAlbumCommand}"
                                        CommandParameter="{Binding Album}">
                                    <Grid ColumnDefinitions="54,*,120" Height="58">
                                        <controls:ArtworkImage Grid.Column="0" Width="46" Height="46" DisplaySize="46" CornerRadius="7"
                                                ServerId="{Binding Album.ServerId}" ArtworkKey="{Binding Album.ArtworkKey}"
                                                FallbackText="{Binding Album.Title}" FallbackFontSize="16" FallbackForeground="{DynamicResource ArtworkFallbackSecondary}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Spacing="2">
                                            <TextBlock Text="{Binding Album.Title}" Classes="primary" />
                                            <TextBlock Text="{Binding Album.ArtistName}" Classes="secondary" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Album.Year}" Classes="secondary" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                            <DataTemplate DataType="vm:SearchArtistRow">
                                <Button Classes="tile" HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[Window].DataContext.OpenArtistCommand}"
                                        CommandParameter="{Binding Artist}">
                                    <Grid ColumnDefinitions="54,*" Height="58">
                                        <controls:ArtworkImage Grid.Column="0" Width="46" Height="46" DisplaySize="46" CornerRadius="23"
                                                ServerId="{Binding Artist.ServerId}" ArtworkKey="{Binding Artist.ArtworkKey}"
                                                FallbackText="{Binding Artist.Name}" FallbackFontSize="16" FallbackForeground="{DynamicResource ArtworkFallbackSecondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Artist.Name}" Classes="primary" VerticalAlignment="Center" Margin="12,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                            <DataTemplate DataType="vm:SearchPlaylistRow">
                                <Button Classes="tile" HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[Window].DataContext.OpenPlaylistCommand}"
                                        CommandParameter="{Binding Playlist}">
                                    <Grid ColumnDefinitions="54,*,120" Height="58">
                                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="7" Background="{DynamicResource SurfaceRaised}">
                                            <controls:TablerIcon Size="22" Data="{StaticResource IconPlaylist}" Brush="{DynamicResource TextSecondary}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Playlist.Title}" Classes="primary" VerticalAlignment="Center" Margin="12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Playlist.TrackCount, StringFormat='{}{0} songs'}"
                                                   Classes="secondary" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>

                    <!-- Downloads: what is queued, transferring or held offline.
                         Progress is polled from the core (a timer in the view
                         model), so these rows refresh in place rather than through
                         a push channel. A ListBox (not a WrapPanel) so the list
                         virtualizes. -->
                    <Grid IsVisible="{Binding ShowDownloads}" RowDefinitions="Auto,*" Margin="0,0,8,0">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,18,0,10">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Downloads" Classes="sectionTitle" />
                                <TextBlock Text="{Binding DownloadStorageSummary}" Classes="secondary" FontSize="12.5" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center"
                                    Command="{Binding RefreshDownloadsCommand}" ToolTip.Tip="Refresh">
                                <controls:TablerIcon Size="18" Data="{StaticResource IconRefresh}"
                                                     Brush="{Binding $parent[Button].Foreground}" />
                            </Button>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding DownloadRows}"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0,0,0,24">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:DownloadRow">
                                    <Border Classes="rowPlate">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Height="46" Classes="libraryTrackRow">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,13,0" Spacing="3">
                                                <TextBlock Text="{Binding Title}" Classes="primary" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Classes="secondary" FontSize="12" />
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"
                                                             Height="3" IsVisible="{Binding ShowProgress}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Classes="secondary"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="ghost" Width="34" Height="34"
                                                        IsVisible="{Binding !IsDownloaded}"
                                                        Command="{Binding $parent[Window].DataContext.CancelDownloadCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Cancel">
                                                    <controls:TablerIcon Size="17" Data="{StaticResource IconX}"
                                                                         Brush="{Binding $parent[Button].Foreground}" />
                                                </Button>
                                                <Button Classes="ghost" Width="34" Height="34"
                                                        Command="{Binding $parent[Window].DataContext.DeleteDownloadCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Remove">
                                                    <controls:TablerIcon Size="17" Data="{StaticResource IconTrash}"
                                                                         Brush="{Binding $parent[Button].Foreground}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Playlists -->
                    <ListBox IsVisible="{Binding ShowPlaylists}"
                             ItemsSource="{Binding PlaylistGrid.Rows}"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile card" Width="216" Margin="0,0,20,24"
                                                    Command="{Binding $parent[Window].DataContext.OpenPlaylistCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Classes="tileSurface" CornerRadius="12" Padding="18" Height="148">
                                                    <StackPanel Spacing="8" VerticalAlignment="Center">
                                                        <controls:TablerIcon Size="32" Data="{StaticResource IconPlaylist}"
                                                                             Brush="{DynamicResource TextSecondary}" />
                                                        <TextBlock Text="{Binding Title}" Classes="primary" FontSize="16" />
                                                        <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} songs'}"
                                                                   Classes="secondary" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Album, artist and playlist details share one virtualized scaffold. -->
                    <ListBox IsVisible="{Binding ShowDetailPage}"
                             ItemsSource="{Binding DetailRows}"
                             x:Name="DetailList"
                             DoubleTapped="OnDetailRowActivated"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent" BorderThickness="0"
                             Padding="0,0,8,28">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:AlbumHeroRow">
                                <WrapPanel Margin="0,0,0,28" Classes="detailHero">
                                    <controls:ArtworkImage Grid.Column="0" Width="220" Height="220" DisplaySize="220"
                                            CornerRadius="13" ServerId="{Binding Album.ServerId}"
                                            ArtworkKey="{Binding Album.ArtworkKey}" FallbackText="{Binding Album.Title}"
                                            FallbackFontSize="62" FallbackForeground="{DynamicResource ArtworkFallbackTertiary}" />
                                    <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Center" Classes="detailHeroText">
                                        <TextBlock Text="{Binding Album.Title}" FontSize="36" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <Button Classes="link" HorizontalAlignment="Left"
                                                Command="{Binding $parent[Window].DataContext.OpenSelectedAlbumArtistCommand}">
                                            <TextBlock Text="{Binding Album.ArtistName}" FontSize="17"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Button>
                                        <TextBlock Text="{Binding Metadata}" Classes="secondary" FontSize="13.5" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                            <Button Classes="primary" Command="{Binding $parent[Window].DataContext.PlaySelectedAlbumCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Filled="True" Data="{StaticResource IconPlay}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Play" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="secondary" Command="{Binding $parent[Window].DataContext.ShuffleSelectedAlbumCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Data="{StaticResource IconShuffle}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Shuffle" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="secondary" Command="{Binding $parent[Window].DataContext.DownloadAlbumCommand}"
                                                    ToolTip.Tip="Download this album">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Data="{StaticResource IconDownload}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Download" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </DataTemplate>

                            <DataTemplate DataType="vm:ArtistHeroRow">
                                <Grid Height="282" Margin="0,0,0,24" ClipToBounds="True">
                                    <Border CornerRadius="16" ClipToBounds="True">
                                        <controls:ArtworkImage Width="980" Height="282" DisplaySize="980"
                                                ArtistHero="True" CornerRadius="16"
                                                ServerId="{Binding Artist.ServerId}" ArtworkKey="{Binding Artist.HeroArtworkKey}"
                                                FallbackText="{Binding Artist.Name}" FallbackFontSize="72"
                                                FallbackForeground="{DynamicResource ArtworkHeroFallback}" />
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Height="130">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="{DynamicResource HeroGradientStart}" Offset="0" />
                                                <GradientStop Color="{DynamicResource HeroGradientEnd}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Margin="24" VerticalAlignment="Bottom" Classes="artistHeroChrome">
                                        <Button Classes="play" Command="{Binding $parent[Window].DataContext.PlaySelectedArtistCommand}">
                                            <controls:TablerIcon Size="20" Filled="True" Data="{StaticResource IconPlay}" Brush="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                        <TextBlock Text="{Binding Artist.Name}" FontSize="38" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Classes="transport lead" Command="{Binding $parent[Window].DataContext.ShuffleSelectedArtistCommand}"
                                                VerticalAlignment="Center">
                                            <controls:TablerIcon Size="18" Data="{StaticResource IconShuffle}"
                                                                 Brush="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                        <Button Classes="transport lead" Command="{Binding $parent[Window].DataContext.StartSelectedArtistRadioCommand}"
                                                VerticalAlignment="Center">
                                            <controls:TablerIcon Size="18" Data="{StaticResource IconMusic}"
                                                                 Brush="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PlaylistHeroRow">
                                <WrapPanel Margin="0,0,0,28" Classes="detailHero">
                                    <Border Grid.Column="0" Width="220" Height="220" Background="{DynamicResource SurfaceRaised}"
                                            CornerRadius="13" Padding="28">
                                        <controls:TablerIcon Size="74" Data="{StaticResource IconPlaylist}"
                                                             Brush="{DynamicResource TextSecondary}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Center" Classes="detailHeroText">
                                        <TextBlock Text="{Binding Playlist.Title}" FontSize="36" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Metadata}" Classes="secondary" FontSize="13.5" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                            <Button Classes="primary" Command="{Binding $parent[Window].DataContext.PlaySelectedPlaylistCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Filled="True" Data="{StaticResource IconPlay}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Play" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="secondary" Command="{Binding $parent[Window].DataContext.ShuffleSelectedPlaylistCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Data="{StaticResource IconShuffle}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Shuffle" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </DataTemplate>

                            <DataTemplate DataType="vm:MixHeroRow">
                                <WrapPanel Margin="0,0,0,28" Classes="detailHero">
                                    <Border Grid.Column="0" Width="220" Height="220" Background="{DynamicResource SurfaceRaised}"
                                            CornerRadius="13" IsVisible="{Binding Mix.IsLiked}">
                                        <controls:TablerIcon Size="74" Filled="True" Data="{StaticResource IconHeart}"
                                                             Brush="{DynamicResource TextPrimary}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <controls:ArtworkImage Grid.Column="0" Width="220" Height="220" DisplaySize="220"
                                            CornerRadius="13" IsVisible="{Binding !Mix.IsLiked}"
                                            ServerId="{Binding Mix.ServerId}" ArtworkKey="{Binding Mix.ArtworkKey}"
                                            FallbackText="{Binding Mix.Title}" FallbackFontSize="62"
                                            FallbackForeground="{DynamicResource ArtworkFallbackTertiary}" />
                                    <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Center" Classes="detailHeroText">
                                        <TextBlock Text="{Binding Mix.Title}" FontSize="36" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Subtitle}" Classes="secondary" FontSize="17"
                                                   IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <TextBlock Text="{Binding Metadata}" Classes="secondary" FontSize="13.5" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                            <Button Classes="primary" Command="{Binding $parent[Window].DataContext.PlaySelectedMixCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Filled="True" Data="{StaticResource IconPlay}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Play" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="secondary" Command="{Binding $parent[Window].DataContext.ShuffleSelectedMixCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Data="{StaticResource IconShuffle}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Shuffle" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </DataTemplate>

                            <DataTemplate DataType="vm:GenreHeroRow">
                                <WrapPanel Margin="0,0,0,28" Classes="detailHero">
                                    <Border Grid.Column="0" Width="220" Height="160" Background="{DynamicResource SurfaceRaised}"
                                            CornerRadius="13" Padding="28">
                                        <controls:TablerIcon Size="74" Data="{StaticResource IconStack}"
                                                             Brush="{DynamicResource TextSecondary}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Center" Classes="detailHeroText">
                                        <TextBlock Text="{Binding Genre}" FontSize="36" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Metadata}" Classes="secondary" FontSize="13.5" />
                                    </StackPanel>
                                </WrapPanel>
                            </DataTemplate>

                            <DataTemplate DataType="vm:DetailSectionRow">
                                <TextBlock Text="{Binding Title}" Classes="sectionTitle" Margin="0,14,0,12" />
                            </DataTemplate>

                            <DataTemplate DataType="vm:DetailAlbumShelfRow">
                                <ItemsControl ItemsSource="{Binding Albums}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile" Width="196" Margin="0,0,0,2"
                                                    Command="{Binding $parent[Window].DataContext.OpenAlbumCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Spacing="9">
                                                    <controls:ArtworkImage Width="176" Height="176" DisplaySize="176" CornerRadius="8"
                                                            ServerId="{Binding ServerId}" ArtworkKey="{Binding ArtworkKey}"
                                                            FallbackText="{Binding Title}" FallbackFontSize="52" FallbackForeground="{DynamicResource ArtworkFallbackTertiary}" />
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Title}" Classes="primary" />
                                                        <TextBlock Text="{Binding Year}" Classes="secondary" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:DetailTrackGridRow">
                                <ItemsControl ItemsSource="{Binding Tracks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile" Command="{Binding $parent[Window].DataContext.PlayArtistTrackCommand}"
                                                    CommandParameter="{Binding Track}">
                                                <Border Width="300" Margin="0,0,20,8" Padding="8" CornerRadius="8"
                                                        Background="{DynamicResource SurfaceRaised}">
                                                    <Grid ColumnDefinitions="44,*,38,64" Height="44">
                                                        <controls:ArtworkImage Grid.Column="0" Width="40" Height="40" DisplaySize="40" CornerRadius="6"
                                                                ServerId="{Binding Track.ServerId}" ArtworkKey="{Binding Track.ArtworkKey}"
                                                                FallbackText="{Binding Track.AlbumTitle}" FallbackFontSize="15" FallbackForeground="{DynamicResource ArtworkFallbackSecondary}" />
                                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{Binding Track.Title}" Classes="primary" />
                                                            <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="ghost" Width="32" Height="32"
                                                                Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}"
                                                                CommandParameter="{Binding Track}"
                                                                ToolTip.Tip="{Binding Track.FavoriteLabel}">
                                                            <Panel Opacity="{Binding Track.FavoritePending, Converter={StaticResource PendingOpacity}}">
                                                                <controls:TablerIcon Size="16" Filled="True" Data="{StaticResource IconHeart}"
                                                                                     Brush="{DynamicResource BrandForeground}" IsVisible="{Binding Track.IsFavorite}" />
                                                                <controls:TablerIcon Size="16" Data="{StaticResource IconHeartOutline}"
                                                                                     Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding !Track.IsFavorite}" />
                                                            </Panel>
                                                        </Button>
                                                        <TextBlock Grid.Column="3" Text="{Binding Track.Duration}" Classes="secondary"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:AlbumTrackItemRow">
                                <Border Classes="rowPlate">
                                    <Grid ColumnDefinitions="36,*,46,46,70" Height="36">
                                        <TextBlock Grid.Column="0" Text="{Binding Row.TrackNumberText}" Classes="secondary"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Row.Track.Title}" Classes="primary" />
                                            <TextBlock Text="{Binding Row.Track.ArtistName}" Classes="secondary" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="ghost" Width="34" Height="34"
                                                Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding Row.Track}"
                                                ToolTip.Tip="{Binding Row.Track.FavoriteLabel}">
                                            <Panel Opacity="{Binding Row.Track.FavoritePending, Converter={StaticResource PendingOpacity}}">
                                                <controls:TablerIcon Size="17" Filled="True" Data="{StaticResource IconHeart}"
                                                                     Brush="{DynamicResource BrandForeground}" IsVisible="{Binding Row.Track.IsFavorite}" />
                                                <controls:TablerIcon Size="17" Data="{StaticResource IconHeartOutline}"
                                                                     Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding !Row.Track.IsFavorite}" />
                                            </Panel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="ghost" Width="34" Height="34"
                                                Command="{Binding $parent[Window].DataContext.DownloadTrackCommand}"
                                                CommandParameter="{Binding Row.Track}"
                                                ToolTip.Tip="Download">
                                            <controls:TablerIcon Size="17" Data="{StaticResource IconDownload}"
                                                                 Brush="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                        <TextBlock Grid.Column="4" Text="{Binding Row.Track.Duration}" Classes="secondary"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PlaylistTrackHeaderRow">
                                <Grid ColumnDefinitions="44,*,Auto,Auto,Auto,Auto" Height="34" Margin="0,8,0,4" Classes="playlistTrackHeaderRow">
                                    <TextBlock Grid.Column="1" Text="Song" Classes="secondary" />
                                    <TextBlock Grid.Column="2" Width="180" Text="Artist" Classes="secondary compactHidden" />
                                    <TextBlock Grid.Column="3" Width="220" Text="Album" Classes="secondary compactHidden" />
                                    <TextBlock Grid.Column="5" Text="Time" Classes="secondary trackDurationColumn" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PlaylistTrackItemRow">
                                <Border Classes="rowPlate">
                                    <Grid ColumnDefinitions="40,*,Auto,Auto,Auto,Auto" Height="40" Classes="playlistTrackRow">
                                        <controls:ArtworkImage Grid.Column="0" Width="40" Height="40" DisplaySize="40" CornerRadius="6"
                                                ServerId="{Binding Track.ServerId}" ArtworkKey="{Binding Track.ArtworkKey}"
                                                FallbackText="{Binding Track.AlbumTitle}" FallbackFontSize="15" FallbackForeground="{DynamicResource ArtworkFallbackSecondary}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0" Spacing="1">
                                            <TextBlock Text="{Binding Track.Title}" Classes="primary" />
                                            <TextBlock Text="{Binding Track.ArtistName}" Classes="secondary" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="link playlistArtistColumn" Width="180" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Command="{Binding $parent[Window].DataContext.OpenTrackArtistCommand}"
                                                CommandParameter="{Binding Track}">
                                            <TextBlock Text="{Binding Track.ArtistName}" Classes="secondary" />
                                        </Button>
                                        <Button Grid.Column="3" Classes="link playlistAlbumColumn" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Command="{Binding $parent[Window].DataContext.OpenTrackAlbumCommand}"
                                                CommandParameter="{Binding Track}">
                                            <TextBlock Text="{Binding Track.AlbumTitle}" Classes="secondary" />
                                        </Button>
                                        <Button Grid.Column="4" Classes="ghost trackFavoriteColumn" Width="34" Height="34"
                                                Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding Track}"
                                                ToolTip.Tip="{Binding Track.FavoriteLabel}">
                                            <Panel Opacity="{Binding Track.FavoritePending, Converter={StaticResource PendingOpacity}}">
                                                <controls:TablerIcon Size="17" Filled="True" Data="{StaticResource IconHeart}"
                                                                     Brush="{DynamicResource BrandForeground}" IsVisible="{Binding Track.IsFavorite}" />
                                                <controls:TablerIcon Size="17" Data="{StaticResource IconHeartOutline}"
                                                                     Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding !Track.IsFavorite}" />
                                            </Panel>
                                        </Button>
                                        <TextBlock Grid.Column="5" Text="{Binding Track.Duration}" Classes="secondary trackDurationColumn"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>


                </Panel>
            </Grid>
        </Grid>

        <!-- Compact navigation leaves the layout flow instead of stealing the
             few columns a phone-width window has. The duplicate buttons are
             deliberate: it keeps the permanent rail and the overlay independent,
             so shrinking the window cannot strand search or section navigation
             behind a collapsed column. -->
        <!-- Full Now Playing.
             A screen, not a panel: it covers the sidebar and the transport
             both, because what makes this read as THE player rather than a
             large artwork pane is that nothing else is on screen while it is
             up. The phone morphs its mini bar into a full sheet; the mechanism
             differs, the result should not.
             The backdrop is the record's own colour, sampled by the
             shared core so this cannot drift from the phone: iOS
             paints these tones as a mesh gradient and Android as a
             drifting canvas, and neither has an equivalent here —
             but the iOS grid is row-uniform, each row one tone, so a
             vertical gradient reproduces the same field. The drift
             is not reproduced: the iOS source calls the motion the
             genuinely per-platform half, it costs a full repaint
             every frame, and the tones are what carry the record's
             identity.

             The view is always dark, in every theme, matching
             Android's note that its foreground is white over
             whatever colour the record turned out to be. Overriding
             the text tiers for this subtree is what makes that true
             for everything inside it at once rather than each
             control hard-coding white and Light quietly breaking
             one of them. -->
        <Border IsVisible="{Binding ShowNowPlaying}"
                Background="{Binding PlayerBackground}"
                Grid.Row="0" Grid.RowSpan="2" ZIndex="15">
            <Border.Resources>
                <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F4" />
                <SolidColorBrush x:Key="TextSecondary" Color="#B9B9C1" />
                <SolidColorBrush x:Key="TextTertiary" Color="#8E8E97" />
                <SolidColorBrush x:Key="SurfaceRaised" Color="#1AFFFFFF" />
                <SolidColorBrush x:Key="SurfaceHover" Color="#26FFFFFF" />
                <SolidColorBrush x:Key="SurfaceSelected" Color="#3AFFFFFF" />
            </Border.Resources>
            <Panel>
                <!-- Light at the top, where there is only colour to
                     look at, and heavy at the bottom, where the seek
                     bar and the times have to stay readable over a
                     record that turned out pale. -->
                <Border Background="{DynamicResource PlayerScrim}" />
        <Grid RowDefinitions="Auto,Auto,*" Margin="26,18,26,22">

            <!-- Its own header, because it no longer sits beneath the page
                 title: somewhere to go back to, and what this is playing from. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <Button Grid.Column="0" Classes="transport"
                        Command="{Binding GoBackCommand}" ToolTip.Tip="Close player">
                    <controls:TablerIcon Size="20" Data="{StaticResource IconChevronLeft}"
                                         Brush="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button Grid.Column="1" Classes="link"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding OpenTrackAlbumCommand}"
                        CommandParameter="{Binding NowPlaying}">
                    <TextBlock Text="{Binding NowPlayingContext, FallbackValue=''}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiary}" />
                </Button>
            </Grid>

            <!-- The hero is one centred column, the way the phone's
                 player is: cover, then what is playing, then the
                 seek bar, then the transport. A left-cover /
                 right-column split put six controls of four
                 different shapes on one line — text buttons, dark
                 rectangles and a crimson circle — and nothing in it
                 said which one was the important one.

                 So the transport is a single row of one shape:
                 round, monochrome, with the play button larger and
                 filled. The things that are ABOUT the track rather
                 than the playback — like, rating, volume — sit
                 quietly on their own line below, because they are
                 not transport and should not compete with it. -->
            <StackPanel x:Name="NowPlayingHeroGrid" Grid.Row="1" Spacing="20"
                        HorizontalAlignment="Center" MaxWidth="700"
                        Margin="0,4,0,28" Classes="nowPlayingHero">

                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="300">
                    <Border CornerRadius="16" ClipToBounds="True"
                            Width="300" Height="300"
                            BoxShadow="0 22 60 -18 #A6000000">
                        <controls:ArtworkImage Width="300" Height="300" DisplaySize="300"
                                CornerRadius="16"
                                ServerId="{Binding NowPlaying.ServerId}"
                                ArtworkKey="{Binding NowPlaying.ArtworkKey}"
                                FallbackText="{Binding NowPlaying.AlbumTitle}"
                                FallbackFontSize="82"
                                FallbackForeground="{DynamicResource ArtworkFallbackTertiary}" />
                    </Border>
                </Viewbox>

                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding NowPlaying.Title, FallbackValue='Not playing'}"
                               FontSize="30" FontWeight="Bold" TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Classes="link" Command="{Binding OpenTrackArtistCommand}" CommandParameter="{Binding NowPlaying}">
                            <TextBlock Text="{Binding NowPlaying.ArtistName, FallbackValue=''}" FontSize="16"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Button>
                        <TextBlock Text="·" Classes="secondary" FontSize="16" />
                        <Button Classes="link" Command="{Binding OpenTrackAlbumCommand}" CommandParameter="{Binding NowPlaying}">
                            <TextBlock Text="{Binding NowPlaying.AlbumTitle, FallbackValue=''}" FontSize="16"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <controls:SeekBar LabelFontSize="12"
                                  RestHeight="7" ActiveHeight="14"
                                  Position="{Binding PositionSeconds}"
                                  Duration="{Binding DurationSeconds}"
                                  TrackKey="{Binding NowPlayingKey}"
                                  SeekCommand="{Binding SeekToCommand}"
                                  Tint="{DynamicResource TextPrimary}" />

                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <Button Classes="transport big" Command="{Binding ToggleShuffleCommand}"
                            ToolTip.Tip="{Binding ShuffleStateText}">
                        <controls:TablerIcon Size="22" Data="{StaticResource IconShuffle}" Brush="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button Classes="transport lead big" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous">
                        <controls:TablerIcon Size="23" Filled="True" Data="{StaticResource IconSkipBack}" Brush="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <!-- Crimson is the app's accent and it is right on
                         the app's own chrome. Here it sits on the
                         RECORD's colour, where over a red album it
                         disappears into the backdrop. -->
                    <Button Classes="play big onArtwork" Command="{Binding TogglePlayPauseCommand}">
                        <Panel>
                            <controls:TablerIcon Size="28" Filled="True" Data="{StaticResource IconPlay}"
                                                 Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding !IsPlaying}" />
                            <controls:TablerIcon Size="28" Filled="True" Data="{StaticResource IconPause}"
                                                 Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding IsPlaying}" />
                        </Panel>
                    </Button>
                    <Button Classes="transport lead big" Command="{Binding NextCommand}" ToolTip.Tip="Next">
                        <controls:TablerIcon Size="23" Filled="True" Data="{StaticResource IconSkipForward}" Brush="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button Classes="transport big" Command="{Binding CycleRepeatCommand}"
                            ToolTip.Tip="{Binding RepeatStateText}">
                        <controls:TablerIcon Size="22" Data="{StaticResource IconRepeat}" Brush="{Binding $parent[Button].Foreground}" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                    <Button Classes="transport" Command="{Binding ToggleFavoriteCommand}"
                            CommandParameter="{Binding NowPlaying}"
                            ToolTip.Tip="{Binding NowPlaying.FavoriteLabel}">
                        <Panel Opacity="{Binding NowPlaying.FavoritePending, Converter={StaticResource PendingOpacity}}">
                            <controls:TablerIcon Size="18" Filled="True" Data="{StaticResource IconHeart}"
                                                 Brush="{DynamicResource BrandForeground}" IsVisible="{Binding NowPlaying.IsFavorite}" />
                            <controls:TablerIcon Size="18" Data="{StaticResource IconHeartOutline}"
                                                 Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding !NowPlaying.IsFavorite}" />
                        </Panel>
                    </Button>

                    <!-- Five taps on one control, so they are sized as
                         one control: a row of bare stars, not five
                         buttons each carrying a button's padding. -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="star" Command="{Binding RateNowPlayingCommand}" CommandParameter="1">
                            <controls:TablerIcon Size="17" Data="{StaticResource IconStar}" Filled="{Binding NowPlaying.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=1}" Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button Classes="star" Command="{Binding RateNowPlayingCommand}" CommandParameter="2">
                            <controls:TablerIcon Size="17" Data="{StaticResource IconStar}" Filled="{Binding NowPlaying.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=2}" Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button Classes="star" Command="{Binding RateNowPlayingCommand}" CommandParameter="3">
                            <controls:TablerIcon Size="17" Data="{StaticResource IconStar}" Filled="{Binding NowPlaying.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=3}" Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button Classes="star" Command="{Binding RateNowPlayingCommand}" CommandParameter="4">
                            <controls:TablerIcon Size="17" Data="{StaticResource IconStar}" Filled="{Binding NowPlaying.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=4}" Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button Classes="star" Command="{Binding RateNowPlayingCommand}" CommandParameter="5">
                            <controls:TablerIcon Size="17" Data="{StaticResource IconStar}" Filled="{Binding NowPlaying.Rating, Converter={StaticResource RatingAtLeast}, ConverterParameter=5}" Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <controls:TablerIcon Size="18" Data="{StaticResource IconVolume}" Brush="{DynamicResource TextSecondary}" />
                        <controls:SeekBar Width="130"
                                          Position="{Binding Volume, Mode=TwoWay}"
                                          Duration="1"
                                          IsContinuous="True"
                                          ShowLabels="False"
                                          RestHeight="5" ActiveHeight="9"
                                          KeyboardStep="0.05"
                                          Tint="{DynamicResource TextPrimary}"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="NowPlayingLowerGrid" Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="26" Classes="nowPlayingLower">
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Lyrics" Classes="sectionTitle" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{DynamicResource SurfaceRaised}" CornerRadius="14" Padding="18"
                        IsVisible="{Binding ShowLyricsSilent}">
                    <TextBlock Text="{Binding LyricsMessage}" Classes="secondary" TextWrapping="Wrap" />
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding LyricsMessage}" Classes="secondary"
                           IsVisible="{Binding !HasLyrics}" />
                <ListBox Grid.Row="1" ItemsSource="{Binding LyricRows}"
                         IsVisible="{Binding HasLyrics}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" Classes="secondary" FontSize="16" TextWrapping="Wrap"
                                       Margin="0,0,0,9" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
                <Grid x:Name="NowPlayingQueuePanel" Grid.Column="1" RowDefinitions="Auto,*" Classes="nowPlayingQueuePanel">
                <TextBlock Grid.Row="0" Text="Play Queue" Classes="sectionTitle" Margin="0,0,0,12" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding QueueRows}"
                         DoubleTapped="OnQueueRowActivated"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,44,*,Auto,Auto,Auto,Auto" Height="54" Classes="queueTrackRow">
                                <TextBlock Grid.Column="0" Width="78" Text="{Binding NumberText}" Classes="secondary compactHidden" VerticalAlignment="Center" />
                                <controls:ArtworkImage Grid.Column="1" Classes="queueArtworkColumn" Width="40" Height="40" DisplaySize="40" CornerRadius="6"
                                        ServerId="{Binding Track.ServerId}" ArtworkKey="{Binding Track.ArtworkKey}"
                                        FallbackText="{Binding Track.AlbumTitle}" FallbackFontSize="15" FallbackForeground="{DynamicResource ArtworkFallbackSecondary}" />
                                <TextBlock Grid.Column="2" Text="{Binding Track.Title}" Classes="primary queueTitleColumn" VerticalAlignment="Center" Margin="13,0" />
                                <Button Grid.Column="3" Classes="link queueArtistColumn" Width="180" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Command="{Binding $parent[Window].DataContext.OpenTrackArtistCommand}"
                                        CommandParameter="{Binding Track}">
                                    <TextBlock Text="{Binding Track.ArtistName}" Classes="secondary" />
                                </Button>
                                <Button Grid.Column="4" Classes="link queueAlbumColumn" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Command="{Binding $parent[Window].DataContext.OpenTrackAlbumCommand}"
                                        CommandParameter="{Binding Track}">
                                    <TextBlock Text="{Binding Track.AlbumTitle}" Classes="secondary" />
                                </Button>
                                <Button Grid.Column="5" Classes="ghost trackFavoriteColumn" Width="34" Height="34"
                                        Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}"
                                        CommandParameter="{Binding Track}"
                                        ToolTip.Tip="{Binding Track.FavoriteLabel}">
                                    <Panel Opacity="{Binding Track.FavoritePending, Converter={StaticResource PendingOpacity}}">
                                        <controls:TablerIcon Size="17" Filled="True" Data="{StaticResource IconHeart}"
                                                             Brush="{DynamicResource BrandForeground}" IsVisible="{Binding Track.IsFavorite}" />
                                        <controls:TablerIcon Size="17" Data="{StaticResource IconHeartOutline}"
                                                             Brush="{Binding $parent[Button].Foreground}" IsVisible="{Binding !Track.IsFavorite}" />
                                    </Panel>
                                </Button>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Classes="queueActionsColumn">
                                    <Button Classes="ghost" Command="{Binding $parent[Window].DataContext.MoveQueueItemUpCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="Up" />
                                    </Button>
                                    <Button Classes="ghost" Command="{Binding $parent[Window].DataContext.MoveQueueItemDownCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="Down" />
                                    </Button>
                                    <Button Classes="destructive" Command="{Binding $parent[Window].DataContext.RemoveQueueItemCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="Remove" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Grid>
        </Grid>
            </Panel>
        </Border>
        <Grid x:Name="CompactNavigationLayer" Grid.RowSpan="2" Panel.ZIndex="20" IsVisible="False">
            <Border Background="{DynamicResource AppBackground}" Opacity="0.72" />
            <Border Width="248"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource SidebarBackground}">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="14,18,14,14">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,0,0,20">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11">
                            <Image Source="avares://Mozz.Desktop/Assets/mozz.png"
                                   Width="28" Height="28"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <TextBlock Text="Mozz" FontSize="21" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="transport"
                                Click="OnCompactNavigationCloseClicked">
                            <controls:TablerIcon Size="18" Data="{StaticResource IconX}"
                                                 Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText}"
                             PlaceholderText="Search your library"
                             Margin="0,0,0,18"
                             CornerRadius="8"
                             FontSize="13"
                             Background="{DynamicResource SearchBackground}"
                             BorderThickness="0"
                             Padding="4,9,11,9">
                        <TextBox.InnerLeftContent>
                            <controls:TablerIcon Size="16" Data="{StaticResource IconSearch}"
                                                 Brush="{DynamicResource TextTertiary}"
                                                 Margin="10,0,4,0" VerticalAlignment="Center" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <StackPanel Grid.Row="2" Spacing="3">
                        <Button Classes="nav" Classes.selected="{Binding IsHomeSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Home}"
                                Click="OnCompactNavigationCloseClicked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconHome}"
                                                     Brush="{Binding #OverlayLblHome.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="OverlayLblHome" Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsSongsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Songs}"
                                Click="OnCompactNavigationCloseClicked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconMusic}"
                                                     Brush="{Binding #OverlayLblSongs.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="OverlayLblSongs" Text="Songs" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsAlbumsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Albums}"
                                Click="OnCompactNavigationCloseClicked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconDisc}"
                                                     Brush="{Binding #OverlayLblAlbums.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="OverlayLblAlbums" Text="Albums" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsArtistsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Artists}"
                                Click="OnCompactNavigationCloseClicked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconArtist}"
                                                     Brush="{Binding #OverlayLblArtists.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="OverlayLblArtists" Text="Artists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsGenresSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Genres}"
                                Click="OnCompactNavigationCloseClicked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconStack}"
                                                     Brush="{Binding #OverlayLblGenres.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="OverlayLblGenres" Text="Genres" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsPlaylistsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Playlists}"
                                Click="OnCompactNavigationCloseClicked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconPlaylist}"
                                                     Brush="{Binding #OverlayLblPlaylists.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="OverlayLblPlaylists" Text="Playlists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="3" Background="{DynamicResource SurfaceRaised}"
                            CornerRadius="11" Padding="12" VerticalAlignment="Bottom"
                            Margin="0,14,0,12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Library" Classes="secondary" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LibrarySummary}" Classes="primary" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="4" Classes="nav" Classes.selected="{Binding IsSettingsSelected}"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="{x:Static vm:LibrarySection.Settings}"
                            Click="OnCompactNavigationCloseClicked">
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="11">
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                    Background="{DynamicResource SurfaceRaised}"
                                    ClipToBounds="True">
                                <Panel>
                                    <controls:ArtworkImage Width="30" Height="30" DisplaySize="30"
                                            CornerRadius="15"
                                            ImageUrl="{Binding ActiveAccountAvatarUrl}"
                                            FallbackText="{Binding ActiveAccountFallbackText}"
                                            FallbackFontSize="12"
                                            FallbackFontWeight="SemiBold"
                                            FallbackForeground="{DynamicResource ArtworkFallbackPrimary}"
                                            IsVisible="{Binding HasActiveAccountAvatar}" />
                                    <controls:TablerIcon Size="18" Data="{StaticResource IconArtist}"
                                                         Brush="{Binding #OverlayLblProfile.Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         IsVisible="{Binding !HasActiveAccountAvatar}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="OverlayLblProfile" Text="{Binding SidebarProfileTitle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SidebarProfileSubtitle}" Classes="secondary" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Cross-device continuity: an offer only, never an automatic takeover. -->
        <Border Grid.Row="0"
                IsVisible="{Binding HasContinuityOffer}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,18"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14">
            <Grid ColumnDefinitions="44,*,Auto,Auto" ColumnSpacing="13" MinWidth="540" MaxWidth="760">
                <controls:ArtworkImage Grid.Column="0"
                        Width="42" Height="42" DisplaySize="42"
                        CornerRadius="8"
                        ServerId="{Binding ContinuityOffer.ServerId}"
                        ArtworkKey="{Binding ContinuityOffer.ArtworkKey}"
                        FallbackText="{Binding ContinuityOffer.Subtitle}"
                        FallbackFontSize="15"
                        FallbackFontWeight="SemiBold"
                        FallbackForeground="{DynamicResource ArtworkFallbackSecondary}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ContinuityOffer.Headline}" Classes="primary"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ContinuityOffer.Subtitle}" Classes="secondary" />
                </StackPanel>
                <Button Grid.Column="2" Content="Listen here" Classes="primary"
                        Command="{Binding ContinueHereCommand}" />
                <Button Grid.Column="3" Classes="ghost"
                        Command="{Binding DismissContinuityOfferCommand}">
                    <controls:TablerIcon Size="18" Data="{StaticResource IconX}"
                                         Brush="{Binding $parent[Button].Foreground}" />
                </Button>
            </Grid>
        </Border>


        <!-- Now playing.
             Expanded keeps the usual desktop three-zone bar. Medium and compact
             widths drop secondary chrome before primary transport: volume is
             recoverable through the OS, but a music player that hides play,
             previous or next has stopped being useful. -->


        <!--
          Parking place for the settings surface while its native window is
          closed. App moves SettingsSurface into one real, movable Window when
          requested, then returns it here on close. Keeping one control tree
          avoids a second copy of five hundred lines of settings UI.
        -->
        <Grid x:Name="SettingsParkingLot" Grid.RowSpan="2" IsVisible="False">
            <Border Background="{DynamicResource AppBackground}" Opacity="0.86" />
            <Border x:Name="SettingsSurface"
                    Margin="0"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid ColumnDefinitions="260,*">
                    <Border Grid.Column="0" Background="{DynamicResource Surface}" CornerRadius="18,0,0,18" Padding="18">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Row="0" Spacing="4" Margin="2,0,0,18">
                                <TextBlock Text="Settings" Classes="sectionTitle" />
                                <TextBlock Text="Mozz" Classes="secondary" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="4">
                                <Button Classes="nav" Classes.selected="{Binding IsSettingsAccountSelected}"
                                        Command="{Binding SelectSettingsCategoryCommand}"
                                        CommandParameter="{x:Static vm:SettingsCategory.AccountServers}">
                                    <TextBlock Text="Account &amp; Servers" />
                                </Button>
                                <Button Classes="nav" Classes.selected="{Binding IsSettingsLibrarySelected}"
                                        Command="{Binding SelectSettingsCategoryCommand}"
                                        CommandParameter="{x:Static vm:SettingsCategory.Library}">
                                    <TextBlock Text="Library" />
                                </Button>
                                <Button Classes="nav" Classes.selected="{Binding IsSettingsPlaybackSelected}"
                                        Command="{Binding SelectSettingsCategoryCommand}"
                                        CommandParameter="{x:Static vm:SettingsCategory.Playback}">
                                    <TextBlock Text="Playback" />
                                </Button>
                                <Button Classes="nav" Classes.selected="{Binding IsSettingsLyricsSelected}"
                                        Command="{Binding SelectSettingsCategoryCommand}"
                                        CommandParameter="{x:Static vm:SettingsCategory.Lyrics}">
                                    <TextBlock Text="Lyrics" />
                                </Button>
                                <Button Classes="nav" Classes.selected="{Binding IsSettingsRecommendationsSelected}"
                                        Command="{Binding SelectSettingsCategoryCommand}"
                                        CommandParameter="{x:Static vm:SettingsCategory.Recommendations}">
                                    <TextBlock Text="Recommendations" />
                                </Button>
                                <Button Classes="nav" Classes.selected="{Binding IsSettingsDevicesSelected}"
                                        Command="{Binding SelectSettingsCategoryCommand}"
                                        CommandParameter="{x:Static vm:SettingsCategory.Devices}">
                                    <TextBlock Text="Sync" />
                                </Button>
                                <Button Classes="nav" Classes.selected="{Binding IsSettingsAppearanceSelected}"
                                        Command="{Binding SelectSettingsCategoryCommand}"
                                        CommandParameter="{x:Static vm:SettingsCategory.Appearance}">
                                    <TextBlock Text="Appearance" />
                                </Button>
                                <Button Classes="nav" Classes.selected="{Binding IsSettingsDiagnosticsSelected}"
                                        Command="{Binding SelectSettingsCategoryCommand}"
                                        CommandParameter="{x:Static vm:SettingsCategory.Diagnostics}">
                                    <TextBlock Text="Diagnostics" />
                                </Button>
                                <Button Classes="nav" Classes.selected="{Binding IsSettingsAboutSelected}"
                                        Command="{Binding SelectSettingsCategoryCommand}"
                                        CommandParameter="{x:Static vm:SettingsCategory.About}">
                                    <TextBlock Text="About" />
                                </Button>
                            </StackPanel>

                            <Button Grid.Row="2" Classes="destructive" HorizontalAlignment="Stretch"
                                    IsVisible="{Binding HasActiveAccount}"
                                    Command="{Binding SignOutCommand}">
                                <TextBlock Text="Sign Out Everywhere" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="28,24,28,24">
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SettingsCategoryTitle}" Classes="pageTitle" />
                                <TextBlock Text="{Binding SettingsCategorySubtitle}" Classes="secondary" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="0,0,8,0">
                            <Panel>
                                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsAccountSelected}">
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14">
                                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25"
                                                    Background="{DynamicResource SurfaceRaised}" ClipToBounds="True">
                                                <Panel>
                                                    <controls:ArtworkImage Width="50" Height="50" DisplaySize="50"
                                                            CornerRadius="25"
                                                            ImageUrl="{Binding ActiveAccountAvatarUrl}"
                                                            FallbackText="{Binding ActiveAccountFallbackText}"
                                                            FallbackFontSize="18"
                                                            FallbackFontWeight="SemiBold"
                                                            FallbackForeground="{DynamicResource ArtworkFallbackPrimary}"
                                                            IsVisible="{Binding HasActiveAccountAvatar}" />
                                                    <controls:TablerIcon Size="26" Data="{StaticResource IconArtist}"
                                                                         Brush="{DynamicResource TextSecondary}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         IsVisible="{Binding !HasActiveAccountAvatar}" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActiveServerTitle}" Classes="sectionTitle" />
                                                <TextBlock Text="{Binding ActiveServerSubtitle}" Classes="secondary" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                        IsVisible="{Binding HasActiveAccount}">
                                                <Button Content="Sync Now" Classes="primary"
                                                        IsEnabled="{Binding !Connect.IsSyncing}"
                                                        Command="{Binding SyncNowCommand}" />
                                                <Button Content="Refresh" Classes="secondary"
                                                        Command="{Binding RefreshSettingsPanelCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Servers" Classes="sectionTitle" />
                                                    <TextBlock Text="Switch, sync, add or sign out of Plex, Jellyfin and Subsonic." Classes="secondary" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LibrarySummary}" Classes="secondary" VerticalAlignment="Center" />
                                            </Grid>

                                            <StackPanel Spacing="10" IsVisible="{Binding Connect.HasAccounts}">
                                                <ItemsControl ItemsSource="{Binding Connect.Accounts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="14" Margin="0,0,0,9">
                                                                <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
                                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Surface}">
                                                                        <controls:TablerIcon Size="17" Data="{StaticResource IconServer}"
                                                                                             Brush="{DynamicResource TextSecondary}"
                                                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ServerName}" Classes="primary" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding BaseUrl}" Classes="secondary" FontSize="11.5" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <Button Content="Use" Classes="secondary"
                                                                                Command="{Binding $parent[Window].DataContext.UseServerCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                        <Button Content="Sync" Classes="secondary"
                                                                                Command="{Binding $parent[Window].DataContext.Connect.SyncAccountCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                        <Button Content="Sign out" Classes="destructive"
                                                                                Command="{Binding $parent[Window].DataContext.Connect.ForgetAccountCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <TextBlock Text="No saved servers yet." Classes="secondary" IsVisible="{Binding !Connect.HasAccounts}" />

                                            <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="16">
                                                <StackPanel Spacing="13">
                                                    <TextBlock Text="Add a server" Classes="primary" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <RadioButton Content="Jellyfin" GroupName="kind"
                                                                     IsChecked="{Binding Connect.Kind, Converter={StaticResource EnumMatch}, ConverterParameter=Jellyfin}" />
                                                        <RadioButton Content="Plex" GroupName="kind"
                                                                     IsChecked="{Binding Connect.Kind, Converter={StaticResource EnumMatch}, ConverterParameter=Plex}" />
                                                        <RadioButton Content="Subsonic" GroupName="kind"
                                                                     IsChecked="{Binding Connect.Kind, Converter={StaticResource EnumMatch}, ConverterParameter=Subsonic}" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="9" IsVisible="{Binding Connect.NeedsCredentials}">
                                                        <TextBox Text="{Binding Connect.ServerUrl}"
                                                                 PlaceholderText="192.168.1.10:8096"
                                                                 CornerRadius="8" Padding="11,9" BorderThickness="0"
                                                                 Background="{DynamicResource SearchBackground}" />
                                                        <TextBox Text="{Binding Connect.Username}"
                                                                 PlaceholderText="Username"
                                                                 CornerRadius="8" Padding="11,9" BorderThickness="0"
                                                                 Background="{DynamicResource SearchBackground}" />
                                                        <TextBox Text="{Binding Connect.Password}"
                                                                 PasswordChar="•"
                                                                 PlaceholderText="Password"
                                                                 CornerRadius="8" Padding="11,9" BorderThickness="0"
                                                                 Background="{DynamicResource SearchBackground}" />
                                                    </StackPanel>

                                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                                               IsVisible="{Binding Connect.IsPlex}"
                                                               Text="Plex signs in through plex.tv. Mozz will give you a link to approve in your browser." />

                                                    <Border IsVisible="{Binding Connect.PlexLinkUrl, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                            Background="{DynamicResource Surface}"
                                                            CornerRadius="10" Padding="15,14">
                                                        <StackPanel Spacing="11">
                                                            <TextBlock Text="Approve Mozz in your browser" Classes="primary" FontWeight="SemiBold" />
                                                            <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap"
                                                                       Text="Open plex.tv, sign in, and Mozz will connect by itself — nothing to type back here." />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Button Content="Open Plex" Classes="primary" Command="{Binding Connect.OpenPlexLinkCommand}" />
                                                                <Button Content="Copy link" Classes="secondary" Command="{Binding Connect.CopyPlexLinkCommand}" />
                                                                <Button Content="Cancel" Classes="secondary" Command="{Binding Connect.CancelPlexCommand}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border IsVisible="{Binding Connect.HasPlexHomeUsers}"
                                                            Background="{DynamicResource Surface}"
                                                            CornerRadius="10"
                                                            Padding="15,14">
                                                        <StackPanel Spacing="11">
                                                            <TextBlock Text="Who’s listening?"
                                                                       Classes="primary"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Choose the Plex profile whose history and restrictions Mozz should use."
                                                                       Classes="secondary"
                                                                       TextWrapping="Wrap" />
                                                            <ItemsControl ItemsSource="{Binding Connect.PlexHomeUsers}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Classes="tile"
                                                                                Margin="0,0,0,7"
                                                                                Command="{Binding $parent[Window].DataContext.Connect.SelectPlexHomeUserCommand}"
                                                                                CommandParameter="{Binding}">
                                                                            <Border Background="{DynamicResource SurfaceRaised}"
                                                                                    CornerRadius="10"
                                                                                    Padding="12">
                                                                                <Grid ColumnDefinitions="*,Auto">
                                                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   Classes="primary"
                                                                                                   FontWeight="SemiBold" />
                                                                                        <TextBlock Text="Home owner"
                                                                                                   Classes="secondary"
                                                                                                   IsVisible="{Binding IsAdmin}" />
                                                                                        <TextBlock Text="Managed profile"
                                                                                                   Classes="secondary"
                                                                                                   IsVisible="{Binding IsRestricted}" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="PIN"
                                                                                               Classes="secondary"
                                                                                               IsVisible="{Binding RequiresPIN}"
                                                                                               VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border IsVisible="{Binding Connect.NeedsPlexProfilePIN}"
                                                            Background="{DynamicResource Surface}"
                                                            CornerRadius="10"
                                                            Padding="15,14">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock Text="Protected Plex profile"
                                                                       Classes="primary"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding Connect.PlexProfilePIN}"
                                                                     PasswordChar="•"
                                                                     PlaceholderText="Profile PIN"
                                                                     MaxLength="16" />
                                                            <TextBlock Text="The PIN goes directly to Plex and is never stored."
                                                                       Classes="secondary" />
                                                            <Button Content="Continue"
                                                                    Classes="primary"
                                                                    HorizontalAlignment="Left"
                                                                    Command="{Binding Connect.ConfirmPlexProfilePINCommand}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Content="Sign in" Classes="primary" HorizontalAlignment="Left"
                                                            IsEnabled="{Binding !Connect.IsBusy}"
                                                            Command="{Binding Connect.SignInCommand}" />

                                                    <TextBlock Text="{Binding Connect.Message}" Classes="secondary" TextWrapping="Wrap"
                                                               IsVisible="{Binding Connect.Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                                    <StackPanel Spacing="7" IsVisible="{Binding Connect.IsSyncing}">
                                                        <ProgressBar Value="{Binding Connect.SyncProgress}" Maximum="1"
                                                                     IsIndeterminate="{Binding !Connect.SyncProgress}"
                                                                     Height="4" CornerRadius="2" />
                                                        <TextBlock Text="{Binding Connect.SyncDetail}" Classes="secondary" FontSize="11.5" />
                                                        <ItemsControl ItemsSource="{Binding Connect.SyncPhaseRows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid ColumnDefinitions="18,*,Auto" Margin="0,2,0,0">
                                                                        <controls:TablerIcon Grid.Column="0" Size="12" Data="{StaticResource IconCheck}"
                                                                                             Brush="{DynamicResource TextSecondary}"
                                                                                             IsVisible="{Binding IsDone}" />
                                                                        <controls:TablerIcon Grid.Column="0" Size="12" Data="{StaticResource IconRefresh}"
                                                                                             Brush="{DynamicResource TextSecondary}"
                                                                                             IsVisible="{Binding IsSyncing}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="secondary" FontSize="11.5" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="secondary" FontSize="11.5" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Connect.SyncDetail}" Classes="secondary" FontSize="11.5"
                                                               IsVisible="{Binding !Connect.IsSyncing}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsLibrarySelected}">
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18"
                                            IsVisible="{Binding HasSettingsLibraries}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Music Libraries" Classes="sectionTitle" />
                                            <TextBlock Text="Pick the library this desktop syncs. Changing it re-attaches the server and syncs." Classes="secondary" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding SettingsLibraries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="tile" Margin="0,0,0,8"
                                                                Command="{Binding $parent[Window].DataContext.SelectMusicLibraryCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="13">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                                        <TextBlock Text="{Binding Name}" Classes="primary" />
                                                                        <TextBlock Text="{Binding Status}" Classes="secondary" />
                                                                    </StackPanel>
                                                                    <controls:TablerIcon Grid.Column="1" Size="19" Data="{StaticResource IconCheck}"
                                                                                         Brush="{DynamicResource TextSecondary}"
                                                                                         IsVisible="{Binding IsSelected}" />
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18"
                                            IsVisible="{Binding !HasSettingsLibraries}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Music Library" Classes="sectionTitle" />
                                            <TextBlock Text="No alternate music libraries are available for the active server." Classes="secondary" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsPlaybackSelected}">
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Playback" Classes="sectionTitle" />
                                            <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="14">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <TextBlock Text="Volume normalization" Classes="primary" FontWeight="SemiBold" />
                                                        <TextBlock Text="Keep songs near the same loudness using ReplayGain track values." Classes="secondary" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding NormalizationEnabled}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <StackPanel Spacing="18">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Equalizer" Classes="sectionTitle" />
                                                    <TextBlock Text="Shape the curve with vertical faders. The center line is 0 dB." Classes="secondary" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding EqualizerEnabled}" VerticalAlignment="Center" />
                                            </Grid>

                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Presets" Classes="primary" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding EqualizerPresetOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Label}" Classes="secondary" Margin="0,0,8,8"
                                                                    Command="{Binding $parent[Window].DataContext.ApplyEqualizerPresetCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <Grid ColumnDefinitions="104,*" ColumnSpacing="24">
                                                <Border Grid.Column="0" Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="14">
                                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                        <TextBlock Text="Preamp" Classes="primary" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding EqualizerPreampText}" Classes="secondary" HorizontalAlignment="Center" />
                                                        <Slider Minimum="-12" Maximum="12" TickFrequency="0.5"
                                                                Orientation="Vertical" Height="188" Width="34"
                                                                Value="{Binding EqualizerPreamp}" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="18,16">
                                                    <Grid RowDefinitions="*,Auto,*">
                                                        <Border Grid.Row="1" Height="1" Background="{DynamicResource Divider}"
                                                                VerticalAlignment="Center" />
                                                        <ItemsControl Grid.RowSpan="3" ItemsSource="{Binding EqualizerBands}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                                        <TextBlock Text="{Binding GainText}" Classes="secondary" FontSize="11" HorizontalAlignment="Center" />
                                                                        <Slider Minimum="-12" Maximum="12" TickFrequency="0.5"
                                                                                Orientation="Vertical" Height="188" Width="34"
                                                                                Value="{Binding Gain}" />
                                                                        <TextBlock Text="{Binding Label}" Classes="secondary" FontSize="11" HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <Button Content="Reset to Flat" Classes="secondary" HorizontalAlignment="Left"
                                                    Command="{Binding ResetEqualizerCommand}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsLyricsSelected}">
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Lyrics" Classes="sectionTitle" />
                                            <TextBlock Text="Desktop lyrics display and offline lyric capture need shared core/FFI support before they can be configured here. This mirrors iOS placement without pretending the controls exist yet."
                                                       Classes="secondary" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsRecommendationsSelected}">
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Recommendations" Classes="sectionTitle" />
                                            <TextBlock Text="MusicBrainz enrichment needs a desktop FFI command before this can become a real control."
                                                       Classes="secondary" TextWrapping="Wrap" />
                                            <TextBlock Text="Not Recommended" Classes="primary" FontWeight="SemiBold" />
                                            <TextBlock Text="Nothing hidden" Classes="secondary" IsVisible="{Binding !HasSuppressions}" />
                                            <ItemsControl ItemsSource="{Binding SuppressedArtists}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Title}" Classes="primary" />
                                                                <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Restore" Classes="secondary"
                                                                    Command="{Binding $parent[Window].DataContext.RestoreSuppressionCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding SuppressedTracks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Title}" Classes="primary" />
                                                                <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Restore" Classes="secondary"
                                                                    Command="{Binding $parent[Window].DataContext.RestoreSuppressionCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsAppearanceSelected}">
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Appearance" Classes="sectionTitle" />
                                            <TextBlock Text="Theme" Classes="primary" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <RadioButton Content="System" GroupName="appearance"
                                                             IsChecked="{Binding Appearance, Converter={StaticResource StringMatch}, ConverterParameter=system}" />
                                                <RadioButton Content="Light" GroupName="appearance"
                                                             IsChecked="{Binding Appearance, Converter={StaticResource StringMatch}, ConverterParameter=light}" />
                                                <RadioButton Content="Dark" GroupName="appearance"
                                                             IsChecked="{Binding Appearance, Converter={StaticResource StringMatch}, ConverterParameter=dark}" />
                                            </StackPanel>
                                            <TextBlock Text="Dark Style" Classes="primary" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <RadioButton Content="Dim" GroupName="darkstyle"
                                                             IsChecked="{Binding DarkStyle, Converter={StaticResource StringMatch}, ConverterParameter=dim}" />
                                                <RadioButton Content="Black" GroupName="darkstyle"
                                                             IsChecked="{Binding DarkStyle, Converter={StaticResource StringMatch}, ConverterParameter=black}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsDiagnosticsSelected}">
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Diagnostics" Classes="sectionTitle" />
                                            <TextBlock Text="{Binding SecretStorageDescription}" Classes="secondary" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SettingsStorageDescription}" Classes="secondary" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DeviceIdentityDescription}" Classes="secondary" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Connect.SyncDetail}" Classes="secondary" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsAboutSelected}">
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="About" Classes="sectionTitle" />
                                            <TextBlock Text="One app for your music, wherever it lives. Free forever. Open source."
                                                       Classes="primary" TextWrapping="Wrap" />
                                            <TextBlock Text="GPL-3.0 · Source on GitHub: https://github.com/thatcube/Mozz"
                                                       Classes="secondary" TextWrapping="Wrap" />
                                            <TextBlock Classes="secondary">
                                                <Run Text="Version" /><Run Text=" " /><Run Text="{Binding AppVersionDisplay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>

                                <StackPanel Spacing="16" IsVisible="{Binding IsSettingsDevicesSelected}">
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Your synced devices" Classes="sectionTitle" />
                                            <TextBlock Text="{Binding CircleSummary}"
                                                       Classes="secondary"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding CircleMembers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="primary" />
                                                            <TextBlock Grid.Column="1" Text="{Binding JoinedDescription}" Classes="secondary" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Background="{DynamicResource SurfaceRaised}"
                                                    CornerRadius="12"
                                                    Padding="14">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <TextBlock Text="Sync between your devices"
                                                                   Classes="primary"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding RelaySyncStatus}"
                                                                   Classes="secondary"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding DeviceSyncEnabled}"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!--
                                      Discovery and approval live in Settings,
                                      not in a second window on top of it.
                                    -->
                                    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18"
                                            DataContext="{Binding Pairing}">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Add a device" Classes="sectionTitle" />
                                            <TextBlock Text="{Binding Status}" Classes="secondary"
                                                       TextWrapping="Wrap" />

                                            <StackPanel Spacing="7" IsVisible="{Binding !IsJoiningCircle}">
                                                <TextBlock Text="Waiting to join" Classes="primary"
                                                           FontWeight="SemiBold" />
                                                <ListBox ItemsSource="{Binding Devices}"
                                                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                                         SelectionMode="Single"
                                                         MaxHeight="150">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,Auto" Margin="4">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                           Classes="primary"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Classes="secondary">
                                                                    <Run Text="{Binding Address}" /><Run Text=":" /><Run Text="{Binding Port}" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>

                                            <Expander Header="Have a code to paste? (optional)"
                                                      IsVisible="{Binding !IsJoiningCircle}">
                                                <TextBox Text="{Binding Code}"
                                                         PlaceholderText="MOZZ1:…"
                                                         AcceptsReturn="False"
                                                         Margin="0,8,0,0"
                                                         FontFamily="monospace" />
                                            </Expander>

                                            <Border IsVisible="{Binding IsComparing}"
                                                    Background="{DynamicResource SurfaceRaised}"
                                                    CornerRadius="12"
                                                    Padding="16">
                                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Digits}"
                                                               FontSize="48"
                                                               FontWeight="Bold"
                                                               FontFamily="monospace"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="Confirm this number on both devices."
                                                               Classes="secondary"
                                                               HorizontalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10"
                                                                HorizontalAlignment="Center">
                                                        <Button Content="Numbers Match" Classes="primary"
                                                                MinWidth="180" Padding="20,12"
                                                                Command="{Binding MatchesCommand}" />
                                                        <Button Content="Numbers Do Not Match" Classes="destructive"
                                                                MinWidth="180" Padding="20,12"
                                                                Command="{Binding DoesNotMatchCommand}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button Content="Add" Classes="primary"
                                                        Command="{Binding PairCommand}"
                                                        IsEnabled="{Binding CanPair}"
                                                        IsVisible="{Binding !IsJoiningCircle}" />
                                                <ProgressBar IsIndeterminate="True"
                                                             IsVisible="{Binding IsBusy}"
                                                             Width="120"
                                                             VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding SettingsMessage}" Classes="secondary" TextWrapping="Wrap"
                                           IsVisible="{Binding SettingsMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
<!-- The transport is a dock, not a band across the bottom.
     A full-width bar with a rule above it divides the window in two and
     makes the library look like it ends early. A floating pill reads as
     something laid ON the app: the content runs underneath it to the
     window's edge, and the controls are a single object you can point
     at. It is what Apple Music does on the desktop and what the phone
     does with its mini player, so all three now agree.

     It floats over row 0 as well as row 1 rather than occupying a band
     of its own; the content column carries bottom padding of its own so
     nothing ends up hidden beneath it. -->
<Border x:Name="BottomTransportBar" Grid.Column="1" ZIndex="10"
        Height="80" MaxWidth="1180"
        Margin="24,0,24,18"
        HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
        Background="{DynamicResource DockBackground}"
        BorderBrush="{DynamicResource DockBorder}"
        BorderThickness="1"
        CornerRadius="22"
        BoxShadow="0 18 44 -14 #8C000000">
    <Grid x:Name="BottomTransportGrid" ColumnDefinitions="*,Auto,*" Margin="18,0">

        <Button Grid.Column="0" Classes="tile" HorizontalAlignment="Left"
                Command="{Binding OpenNowPlayingCommand}">
            <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                <controls:ArtworkImage Width="56" Height="56" DisplaySize="56"
                        CornerRadius="7"
                        ServerId="{Binding NowPlaying.ServerId}"
                        ArtworkKey="{Binding NowPlaying.ArtworkKey}"
                        FallbackText="{Binding NowPlaying.AlbumTitle}"
                        FallbackFontSize="20"
                        FallbackFontWeight="SemiBold"
                        FallbackForeground="{DynamicResource ArtworkFallbackPrimary}" />
                <StackPanel x:Name="NowPlayingSummaryText" VerticalAlignment="Center" Spacing="3" MaxWidth="270">
                    <TextBlock Classes="primary" FontWeight="Medium"
                               Text="{Binding NowPlaying.Title, FallbackValue='Not playing'}" />
                    <TextBlock Classes="secondary"
                               Text="{Binding NowPlaying.ArtistName, FallbackValue=''}" />
                </StackPanel>
            </StackPanel>
        </Button>

        <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="11" HorizontalAlignment="Center">
                <Button x:Name="BottomShuffleButton" Classes="transport" Command="{Binding ToggleShuffleCommand}">
                    <controls:TablerIcon Size="19" Data="{StaticResource IconShuffle}"
                                         Brush="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button Classes="transport lead" Command="{Binding PreviousCommand}">
                    <controls:TablerIcon Size="18" Filled="True" Data="{StaticResource IconSkipBack}"
                                         Brush="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button Classes="play" Command="{Binding TogglePlayPauseCommand}">
                    <Panel>
                        <controls:TablerIcon Size="20" Filled="True" Data="{StaticResource IconPlay}"
                                             Brush="{Binding $parent[Button].Foreground}"
                                             IsVisible="{Binding !IsPlaying}" />
                        <controls:TablerIcon Size="20" Filled="True" Data="{StaticResource IconPause}"
                                             Brush="{Binding $parent[Button].Foreground}"
                                             IsVisible="{Binding IsPlaying}" />
                    </Panel>
                </Button>
                <Button Classes="transport lead" Command="{Binding NextCommand}">
                    <controls:TablerIcon Size="18" Filled="True" Data="{StaticResource IconSkipForward}"
                                         Brush="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button x:Name="BottomRepeatButton" Classes="transport" Command="{Binding CycleRepeatCommand}">
                    <controls:TablerIcon Size="19" Data="{StaticResource IconRepeat}"
                                         Brush="{Binding $parent[Button].Foreground}" />
                </Button>
            </StackPanel>
            <StackPanel x:Name="BottomPositionRow" Orientation="Horizontal" HorizontalAlignment="Center">
                <controls:SeekBar x:Name="BottomScrubber" Width="420"
                                  Position="{Binding PositionSeconds}"
                                  Duration="{Binding DurationSeconds}"
                                  TrackKey="{Binding NowPlayingKey}"
                                  SeekCommand="{Binding SeekToCommand}"
                                  Tint="{DynamicResource TextPrimary}" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="BottomVolumeControls" Grid.Column="2" Orientation="Horizontal" Spacing="12"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Classes="transport" Command="{Binding OpenNowPlayingCommand}">
                <controls:TablerIcon Size="19" Data="{StaticResource IconQueue}"
                                     Brush="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button Classes="transport">
                <controls:TablerIcon Size="19" Data="{StaticResource IconVolume}"
                                     Brush="{Binding $parent[Button].Foreground}" />
            </Button>
            <Slider Classes="scrub" Width="96" Minimum="0" Maximum="1"
                    Value="{Binding Volume, Mode=TwoWay}"
                    VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Border>
        </Grid>
    </Grid>
</Window>
