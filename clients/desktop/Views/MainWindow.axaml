<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mozz.Desktop.ViewModels"
        xmlns:core="using:Mozz.Desktop.Core"
        xmlns:controls="using:Mozz.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="880"
        x:Class="Mozz.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1360" Height="880"
        MinWidth="940" MinHeight="620"
        Background="{DynamicResource AppBackground}"
        Title="Mozz"
        Icon="avares://Mozz.Desktop/Assets/mozz.ico">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding ClosePlayerCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <core:EnumMatchConverter x:Key="EnumMatch" />
        <core:StringMatchConverter x:Key="StringMatch" />
    </Window.Resources>

    <!--
      Three bands, the arrangement every desktop player converges on because it
      works: a sidebar that never moves, content that scrolls, and transport
      pinned to the bottom so it stays reachable however deep you've browsed.
    -->
    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="248,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14,18,14,14">

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="6,0,0,20">
                        <!-- The actual app icon, not a letter in a box. The art
                             is a pixel-art disc with transparent corners, so it
                             needs no rounded plate behind it. -->
                        <Image Source="avares://Mozz.Desktop/Assets/mozz.png"
                               Width="28" Height="28"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Mozz" FontSize="21" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText}"
                             PlaceholderText="Search your library"
                             Margin="0,0,0,18"
                             CornerRadius="8"
                             FontSize="13"
                             Background="{DynamicResource SurfaceRaised}"
                             BorderBrush="{DynamicResource SurfaceBorder}"
                             BorderThickness="{DynamicResource SurfaceBorderThickness}"
                             Padding="4,9,11,9">
                        <TextBox.InnerLeftContent>
                            <controls:TablerIcon Size="16" Data="{StaticResource IconSearch}"
                                                 Brush="{DynamicResource TextTertiary}"
                                                 Margin="10,0,4,0" VerticalAlignment="Center" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <StackPanel Grid.Row="2" Spacing="3">
                        <Button Classes="nav" Classes.selected="{Binding IsHomeSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Home}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconHome}"
                                                     Brush="{Binding #LblHome.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblHome" Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsSongsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Songs}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconMusic}"
                                                     Brush="{Binding #LblSongs.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblSongs" Text="Songs" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsAlbumsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Albums}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconDisc}"
                                                     Brush="{Binding #LblAlbums.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblAlbums" Text="Albums" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsArtistsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Artists}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconArtist}"
                                                     Brush="{Binding #LblArtists.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblArtists" Text="Artists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsPlaylistsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Playlists}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconPlaylist}"
                                                     Brush="{Binding #LblPlaylists.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblPlaylists" Text="Playlists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsConnectSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Connect}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconServer}"
                                                     Brush="{Binding #LblServers.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblServers" Text="Servers" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.selected="{Binding IsSettingsSelected}"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Settings}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:TablerIcon Size="19" Data="{StaticResource IconSettings}"
                                                     Brush="{Binding #LblSettings.Foreground}"
                                                     VerticalAlignment="Center" />
                                <TextBlock x:Name="LblSettings" Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Text="{Binding LibrarySummary}"
                               Classes="secondary"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="6,12,6,4" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="32,26,24,0">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,20">
                    <Button Grid.Column="0" Classes="transport"
                            Margin="0,0,12,0"
                            IsVisible="{Binding CanGoBack}"
                            Command="{Binding GoBackCommand}">
                        <controls:TablerIcon Size="19" Data="{StaticResource IconChevronLeft}"
                                             Brush="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="{Binding PageTitle}" Classes="pageTitle" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="secondary"
                               IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Grid>

                <Panel Grid.Row="1" x:Name="ContentPane" SizeChanged="OnContentResized">

                    <StackPanel IsVisible="{Binding IsLibraryEmpty}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="11" MaxWidth="430">
                        <TextBlock Text="Nothing here yet" Classes="sectionTitle"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Connect a Plex, Jellyfin or Subsonic server and Mozz will sync your library." />
                        <Button Content="Connect a server"
                                HorizontalAlignment="Center"
                                Classes="accent large"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="{x:Static vm:LibrarySection.Connect}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowHomeEmpty}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="11" MaxWidth="430">
                        <TextBlock Text="No mixes yet" Classes="sectionTitle"
                                  HorizontalAlignment="Center" />
                        <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                                  Text="Play more music and Mozz will build Home from your listening history." />
                    </StackPanel>

                    <!-- Home. A ListBox of rows keeps the mixes grid and every
                         shelf virtualized; each row realizes only the few cards
                         that fit across the current window. -->
                    <ListBox IsVisible="{Binding ShowHomeRows}"
                             ItemsSource="{Binding HomeRows}"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:HomeMixGridRow">
                                <ItemsControl ItemsSource="{Binding Mixes}">
                                   <ItemsControl.ItemsPanel>
                                       <ItemsPanelTemplate>
                                           <StackPanel Orientation="Horizontal" />
                                       </ItemsPanelTemplate>
                                   </ItemsControl.ItemsPanel>
                                   <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                           <Button Classes="tile card" Width="410" Margin="0,0,20,16"
                                                   Command="{Binding $parent[Window].DataContext.OpenMixCommand}"
                                                   CommandParameter="{Binding}">
                                               <Border Classes="tileSurface" CornerRadius="12" ClipToBounds="True">
                                                   <Grid ColumnDefinitions="88,*" Height="88">
                                                       <Border Grid.Column="0" Background="{DynamicResource Accent}"
                                                               IsVisible="{Binding IsLiked}">
                                                           <controls:TablerIcon Size="30" Filled="True"
                                                                                Data="{StaticResource IconHeart}"
                                                                                Brush="White"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                       </Border>
                                                       <controls:ArtworkImage Grid.Column="0"
                                                               Width="88" Height="88" DisplaySize="88"
                                                               CornerRadius="0"
                                                               IsVisible="{Binding !IsLiked}"
                                                               ServerId="{Binding ServerId}"
                                                               ArtworkKey="{Binding ArtworkKey}"
                                                               FallbackText="{Binding FallbackText}"
                                                               FallbackFontSize="24"
                                                               FallbackFontWeight="SemiBold"
                                                               FallbackForeground="#66FFFFFF" />
                                                       <StackPanel Grid.Column="1" Spacing="4"
                                                                   VerticalAlignment="Center" Margin="18,0,16,0">
                                                           <TextBlock Text="{Binding Title}" Classes="primary"
                                                                      FontSize="22" FontWeight="SemiBold" />
                                                           <TextBlock Text="{Binding Subtitle}" Classes="secondary"
                                                                      FontSize="15"
                                                                      IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                       </StackPanel>
                                                   </Grid>
                                               </Border>
                                           </Button>
                                       </DataTemplate>
                                   </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:HomeSectionTitleRow">
                                <TextBlock Text="{Binding Title}" Classes="sectionTitle" Margin="0,10,0,12" />
                            </DataTemplate>

                            <DataTemplate DataType="vm:HomeTrackShelfRow">
                                <ItemsControl ItemsSource="{Binding Tracks}">
                                   <ItemsControl.ItemsPanel>
                                       <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                   </ItemsControl.ItemsPanel>
                                   <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                           <Button Classes="tile card" Command="{Binding $parent[Window].DataContext.PlayHomeTrackCommand}"
                                                   CommandParameter="{Binding}">
                                               <Border Classes="tileSurface" Width="300" Margin="0,0,20,12" Padding="8" CornerRadius="8">
                                                   <Grid ColumnDefinitions="44,*,64" Height="44">
                                                       <controls:ArtworkImage Grid.Column="0" Width="38" Height="38" DisplaySize="38" CornerRadius="6"
                                                               ServerId="{Binding Track.ServerId}" ArtworkKey="{Binding Track.ArtworkKey}"
                                                               FallbackText="{Binding Track.AlbumTitle}" FallbackFontSize="15" FallbackForeground="#88FFFFFF" />
                                                       <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                                           <TextBlock Text="{Binding Track.Title}" Classes="primary" />
                                                           <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                                                       </StackPanel>
                                                       <TextBlock Grid.Column="2" Text="{Binding Track.Duration}" Classes="secondary"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                   </Grid>
                                               </Border>
                                           </Button>
                                       </DataTemplate>
                                   </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:HomeAlbumShelfRow">
                                <ItemsControl ItemsSource="{Binding Albums}">
                                   <ItemsControl.ItemsPanel>
                                       <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                   </ItemsControl.ItemsPanel>
                                   <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                           <Button Classes="tile" Width="196" Margin="0,0,0,2"
                                                   Command="{Binding $parent[Window].DataContext.OpenAlbumCommand}"
                                                   CommandParameter="{Binding}">
                                               <StackPanel Spacing="9">
                                                   <controls:ArtworkImage Width="176" Height="176" DisplaySize="176" CornerRadius="8"
                                                           ServerId="{Binding ServerId}" ArtworkKey="{Binding ArtworkKey}"
                                                           FallbackText="{Binding Title}" FallbackFontSize="52" FallbackForeground="#55FFFFFF" />
                                                   <StackPanel Spacing="2">
                                                       <TextBlock Text="{Binding Title}" Classes="primary" />
                                                       <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                                   </StackPanel>
                                               </StackPanel>
                                           </Button>
                                       </DataTemplate>
                                   </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:HomePlaylistShelfRow">
                                <ItemsControl ItemsSource="{Binding Playlists}">
                                   <ItemsControl.ItemsPanel>
                                       <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                   </ItemsControl.ItemsPanel>
                                   <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                           <Button Classes="tile card" Width="216" Margin="0,0,20,22"
                                                   Command="{Binding $parent[Window].DataContext.OpenPlaylistCommand}"
                                                   CommandParameter="{Binding}">
                                               <Border Classes="tileSurface" CornerRadius="12" Padding="18" Height="148">
                                                   <StackPanel Spacing="8" VerticalAlignment="Center">
                                                       <controls:TablerIcon Size="32" Data="{StaticResource IconPlaylist}"
                                                                            Brush="{DynamicResource Accent}" />
                                                       <TextBlock Text="{Binding Title}" Classes="primary" FontSize="16" />
                                                       <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} songs'}"
                                                                  Classes="secondary" />
                                                   </StackPanel>
                                               </Border>
                                           </Button>
                                       </DataTemplate>
                                   </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>

                    <!-- Songs / search results.
                         ListBox rather than ItemsControl: it virtualizes, which is
                         what keeps a hundred thousand rows scrolling smoothly. -->
                    <ListBox IsVisible="{Binding ShowTracks}"
                             x:Name="TracksList"
                             ItemsSource="{Binding Tracks}"
                             DoubleTapped="OnTrackActivated"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent"
                             Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="rowPlate">
                                <Grid ColumnDefinitions="40,*,200,64" Height="40">
                                    <controls:ArtworkImage Grid.Column="0"
                                            Width="40" Height="40" DisplaySize="40"
                                            CornerRadius="6"
                                            ServerId="{Binding ServerId}"
                                            ArtworkKey="{Binding ArtworkKey}"
                                            FallbackText="{Binding AlbumTitle}"
                                            FallbackFontSize="15"
                                            FallbackFontWeight="SemiBold"
                                            FallbackForeground="#88FFFFFF" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Margin="13,0" Spacing="1">
                                        <TextBlock Text="{Binding Title}" Classes="primary" />
                                        <Button Classes="link"
                                                HorizontalAlignment="Left"
                                                Command="{Binding $parent[Window].DataContext.OpenTrackArtistCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="link"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[Window].DataContext.OpenTrackAlbumCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding AlbumTitle}" Classes="secondary" />
                                    </Button>
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}"
                                               Classes="secondary" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="0,0,10,0" />
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Albums -->
                    <!-- Albums.
                         A ListBox of ROWS, not a WrapPanel of tiles: Avalonia has
                         only VirtualizingStackPanel, so chunking into rows is what
                         buys virtualization. See ViewModels/GridRows.cs. -->
                    <ListBox IsVisible="{Binding ShowAlbums}"
                             ItemsSource="{Binding AlbumGrid.Rows}"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <!-- A row is a layout device, not something to select.
                                 Without these the ListBox paints its selected and
                                 hover chrome across a whole row of tiles, which
                                 reads as a rendering fault. -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile" Width="196" Margin="0,0,0,4"
                                                    Command="{Binding $parent[Window].DataContext.OpenAlbumCommand}"
                                                    CommandParameter="{Binding}">
                                            <StackPanel Spacing="9">
                                                <controls:ArtworkImage
                                                        Width="176" Height="176" DisplaySize="176"
                                                        CornerRadius="8"
                                                        ServerId="{Binding ServerId}"
                                                        ArtworkKey="{Binding ArtworkKey}"
                                                        FallbackText="{Binding Title}"
                                                        FallbackFontSize="52"
                                                        FallbackForeground="#55FFFFFF" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}" Classes="primary" />
                                                    <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                                </StackPanel>
                                            </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Artists -->
                    <ListBox IsVisible="{Binding ShowArtists}"
                             ItemsSource="{Binding ArtistGrid.Rows}"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <!-- A row is a layout device, not something to select.
                                 Without these the ListBox paints its selected and
                                 hover chrome across a whole row of tiles, which
                                 reads as a rendering fault. -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile" Width="178" Margin="0,0,0,4"
                                                    Command="{Binding $parent[Window].DataContext.OpenArtistCommand}"
                                                    CommandParameter="{Binding}">
                                            <StackPanel Spacing="10">
                                                <controls:ArtworkImage
                                                        Width="138" Height="138" DisplaySize="138"
                                                        CornerRadius="69"
                                                        HorizontalAlignment="Center"
                                                        ServerId="{Binding ServerId}"
                                                        ArtworkKey="{Binding ArtworkKey}"
                                                        FallbackText="{Binding Name}"
                                                        FallbackFontSize="44"
                                                        FallbackForeground="#55FFFFFF" />
                                                <TextBlock Text="{Binding Name}" Classes="primary"
                                                           TextAlignment="Center" />
                                            </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Search: compact result groups. Each item pushes onto the
                         same navigation stack as the library walls. -->
                    <ScrollViewer IsVisible="{Binding ShowSearch}">
                        <StackPanel Spacing="28" Margin="0,0,8,24">
                            <StackPanel Spacing="12" IsVisible="{Binding HasSearchAlbums}">
                                <TextBlock Text="Albums" Classes="sectionTitle" />
                                <ItemsControl ItemsSource="{Binding AlbumGrid.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="tile" Width="196" Margin="0,0,0,0"
                                                                Command="{Binding $parent[Window].DataContext.OpenAlbumCommand}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Spacing="9">
                                                                <controls:ArtworkImage Width="176" Height="176" DisplaySize="176"
                                                                        CornerRadius="8"
                                                                        ServerId="{Binding ServerId}"
                                                                        ArtworkKey="{Binding ArtworkKey}"
                                                                        FallbackText="{Binding Title}"
                                                                        FallbackFontSize="52"
                                                                        FallbackForeground="#55FFFFFF" />
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding Title}" Classes="primary" />
                                                                    <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="12" IsVisible="{Binding HasSearchArtists}">
                                <TextBlock Text="Artists" Classes="sectionTitle" />
                                <ItemsControl ItemsSource="{Binding ArtistGrid.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="tile" Width="178" Margin="0,0,0,0"
                                                                Command="{Binding $parent[Window].DataContext.OpenArtistCommand}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Spacing="10">
                                                                <controls:ArtworkImage Width="138" Height="138" DisplaySize="138"
                                                                        CornerRadius="69"
                                                                        HorizontalAlignment="Center"
                                                                        ServerId="{Binding ServerId}"
                                                                        ArtworkKey="{Binding ArtworkKey}"
                                                                        FallbackText="{Binding Name}"
                                                                        FallbackFontSize="44"
                                                                        FallbackForeground="#55FFFFFF" />
                                                                <TextBlock Text="{Binding Name}" Classes="primary" TextAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="12" IsVisible="{Binding HasSearchTracks}">
                                <TextBlock Text="Songs" Classes="sectionTitle" />
                                <ListBox ItemsSource="{Binding Tracks}"
                                         DoubleTapped="OnTrackActivated"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="rowPlate">
                                <Grid ColumnDefinitions="40,*,200,64" Height="40">
                                                <controls:ArtworkImage Grid.Column="0" Width="40" Height="40" DisplaySize="40"
                                                        CornerRadius="6"
                                                        ServerId="{Binding ServerId}"
                                                        ArtworkKey="{Binding ArtworkKey}"
                                                        FallbackText="{Binding AlbumTitle}"
                                                        FallbackFontSize="15"
                                                        FallbackFontWeight="SemiBold"
                                                        FallbackForeground="#88FFFFFF" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0" Spacing="1">
                                                    <TextBlock Text="{Binding Title}" Classes="primary" />
                                                    <Button Classes="link" HorizontalAlignment="Left"
                                                            Command="{Binding $parent[Window].DataContext.OpenTrackArtistCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding ArtistName}" Classes="secondary" />
                                                    </Button>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="link" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Command="{Binding $parent[Window].DataContext.OpenTrackAlbumCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding AlbumTitle}" Classes="secondary" />
                                                </Button>
                                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Classes="secondary"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                            </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Playlists -->
                    <ListBox IsVisible="{Binding ShowPlaylists}"
                             ItemsSource="{Binding PlaylistGrid.Rows}"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Padding="0,0,8,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile card" Width="216" Margin="0,0,20,24"
                                                    Command="{Binding $parent[Window].DataContext.OpenPlaylistCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Classes="tileSurface" CornerRadius="12" Padding="18" Height="148">
                                                    <StackPanel Spacing="8" VerticalAlignment="Center">
                                                        <controls:TablerIcon Size="32" Data="{StaticResource IconPlaylist}"
                                                                             Brush="{DynamicResource Accent}" />
                                                        <TextBlock Text="{Binding Title}" Classes="primary" FontSize="16" />
                                                        <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} songs'}"
                                                                   Classes="secondary" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Album, artist and playlist details share one virtualized scaffold. -->
                    <ListBox IsVisible="{Binding ShowDetailPage}"
                             ItemsSource="{Binding DetailRows}"
                             x:Name="DetailList"
                             DoubleTapped="OnDetailRowActivated"
                             ScrollViewer.ScrollChanged="OnListScrolled"
                             Background="Transparent" BorderThickness="0"
                             Padding="0,0,8,28">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:AlbumHeroRow">
                                <Grid ColumnDefinitions="236,*" Margin="0,0,0,28">
                                    <controls:ArtworkImage Grid.Column="0" Width="220" Height="220" DisplaySize="220"
                                            CornerRadius="13" ServerId="{Binding Album.ServerId}"
                                            ArtworkKey="{Binding Album.ArtworkKey}" FallbackText="{Binding Album.Title}"
                                            FallbackFontSize="62" FallbackForeground="#55FFFFFF" />
                                    <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Album.Title}" FontSize="36" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <Button Classes="link" HorizontalAlignment="Left"
                                                Command="{Binding $parent[Window].DataContext.OpenSelectedAlbumArtistCommand}">
                                            <TextBlock Text="{Binding Album.ArtistName}" FontSize="17"
                                                       Foreground="{DynamicResource Accent}" />
                                        </Button>
                                        <TextBlock Text="{Binding Metadata}" Classes="secondary" FontSize="13.5" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                            <Button Classes="accent large" Command="{Binding $parent[Window].DataContext.PlaySelectedAlbumCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Filled="True" Data="{StaticResource IconPlay}" Brush="White" />
                                                    <TextBlock Text="Play" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="large" Command="{Binding $parent[Window].DataContext.ShuffleSelectedAlbumCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Data="{StaticResource IconShuffle}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Shuffle" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="vm:ArtistHeroRow">
                                <Grid Height="282" Margin="0,0,0,24" ClipToBounds="True">
                                    <Border CornerRadius="16" ClipToBounds="True">
                                        <controls:ArtworkImage Width="980" Height="282" DisplaySize="980"
                                                ArtistHero="True" CornerRadius="16"
                                                ServerId="{Binding Artist.ServerId}" ArtworkKey="{Binding Artist.HeroArtworkKey}"
                                                FallbackText="{Binding Artist.Name}" FallbackFontSize="72"
                                                FallbackForeground="#44FFFFFF" />
                                    </Border>
                                    <!-- Fades into whatever the page's own background
                                         is, rather than into a baked near-black: in
                                         Black that has to be black, and in Light it
                                         must not be dark at all. -->
                                    <Border VerticalAlignment="Bottom" Height="130"
                                            Background="{DynamicResource HeroScrim}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="24" VerticalAlignment="Bottom">
                                        <Button Classes="play" Command="{Binding $parent[Window].DataContext.PlaySelectedArtistCommand}">
                                            <controls:TablerIcon Size="20" Filled="True" Data="{StaticResource IconPlay}" Brush="White" />
                                        </Button>
                                        <TextBlock Text="{Binding Artist.Name}" FontSize="38" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        <Button Classes="transport lead" Command="{Binding $parent[Window].DataContext.ShuffleSelectedArtistCommand}"
                                                VerticalAlignment="Center">
                                            <controls:TablerIcon Size="18" Data="{StaticResource IconShuffle}"
                                                                 Brush="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                        <Button Classes="transport lead" Command="{Binding $parent[Window].DataContext.StartSelectedArtistRadioCommand}"
                                                VerticalAlignment="Center">
                                            <controls:TablerIcon Size="18" Data="{StaticResource IconMusic}"
                                                                 Brush="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PlaylistHeroRow">
                                <Grid ColumnDefinitions="236,*" Margin="0,0,0,28">
                                    <Border Grid.Column="0" Width="220" Height="220" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}"
                                            CornerRadius="13" Padding="28">
                                        <controls:TablerIcon Size="74" Data="{StaticResource IconPlaylist}"
                                                             Brush="{DynamicResource Accent}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Playlist.Title}" FontSize="36" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Metadata}" Classes="secondary" FontSize="13.5" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                            <Button Classes="accent large" Command="{Binding $parent[Window].DataContext.PlaySelectedPlaylistCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Filled="True" Data="{StaticResource IconPlay}" Brush="White" />
                                                    <TextBlock Text="Play" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="large" Command="{Binding $parent[Window].DataContext.ShuffleSelectedPlaylistCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Data="{StaticResource IconShuffle}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Shuffle" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="vm:MixHeroRow">
                                <Grid ColumnDefinitions="236,*" Margin="0,0,0,28">
                                    <Border Grid.Column="0" Width="220" Height="220" Background="{DynamicResource Accent}"
                                            CornerRadius="13" IsVisible="{Binding Mix.IsLiked}">
                                        <controls:TablerIcon Size="74" Filled="True" Data="{StaticResource IconHeart}"
                                                             Brush="White"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <controls:ArtworkImage Grid.Column="0" Width="220" Height="220" DisplaySize="220"
                                            CornerRadius="13" IsVisible="{Binding !Mix.IsLiked}"
                                            ServerId="{Binding Mix.ServerId}" ArtworkKey="{Binding Mix.ArtworkKey}"
                                            FallbackText="{Binding Mix.Title}" FallbackFontSize="62"
                                            FallbackForeground="#55FFFFFF" />
                                    <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Mix.Title}" FontSize="36" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Subtitle}" Classes="secondary" FontSize="17"
                                                   IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <TextBlock Text="{Binding Metadata}" Classes="secondary" FontSize="13.5" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                            <Button Classes="accent large" Command="{Binding $parent[Window].DataContext.PlaySelectedMixCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Filled="True" Data="{StaticResource IconPlay}" Brush="White" />
                                                    <TextBlock Text="Play" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="large" Command="{Binding $parent[Window].DataContext.ShuffleSelectedMixCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <controls:TablerIcon Size="15" Data="{StaticResource IconShuffle}" Brush="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Shuffle" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="vm:DetailSectionRow">
                                <TextBlock Text="{Binding Title}" Classes="sectionTitle" Margin="0,14,0,12" />
                            </DataTemplate>

                            <DataTemplate DataType="vm:DetailAlbumShelfRow">
                                <ItemsControl ItemsSource="{Binding Albums}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile" Width="196" Margin="0,0,0,2"
                                                    Command="{Binding $parent[Window].DataContext.OpenAlbumCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Spacing="9">
                                                    <controls:ArtworkImage Width="176" Height="176" DisplaySize="176" CornerRadius="8"
                                                            ServerId="{Binding ServerId}" ArtworkKey="{Binding ArtworkKey}"
                                                            FallbackText="{Binding Title}" FallbackFontSize="52" FallbackForeground="#55FFFFFF" />
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Title}" Classes="primary" />
                                                        <TextBlock Text="{Binding Year}" Classes="secondary" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:DetailTrackGridRow">
                                <ItemsControl ItemsSource="{Binding Tracks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="tile card" Command="{Binding $parent[Window].DataContext.PlayArtistTrackCommand}"
                                                    CommandParameter="{Binding Track}">
                                                <Border Classes="tileSurface" Width="300" Margin="0,0,20,8" Padding="8" CornerRadius="8">
                                                    <Grid ColumnDefinitions="44,*,64" Height="44">
                                                        <controls:ArtworkImage Grid.Column="0" Width="38" Height="38" DisplaySize="38" CornerRadius="6"
                                                                ServerId="{Binding Track.ServerId}" ArtworkKey="{Binding Track.ArtworkKey}"
                                                                FallbackText="{Binding Track.AlbumTitle}" FallbackFontSize="15" FallbackForeground="#88FFFFFF" />
                                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{Binding Track.Title}" Classes="primary" />
                                                            <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Track.Duration}" Classes="secondary"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>

                            <DataTemplate DataType="vm:AlbumTrackItemRow">
                                <Border Classes="rowPlate">
                                <Grid ColumnDefinitions="36,*,70" Height="36">
                                    <TextBlock Grid.Column="0" Text="{Binding Row.TrackNumberText}" Classes="secondary"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Row.Track.Title}" Classes="primary" />
                                        <TextBlock Text="{Binding Row.Track.ArtistName}" Classes="secondary" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Row.Track.Duration}" Classes="secondary"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PlaylistTrackHeaderRow">
                                <Border Padding="8,0" Margin="0,10,0,2">
                                <Grid ColumnDefinitions="40,*,180,220,64" Height="34">
                                    <TextBlock Grid.Column="1" Text="Song" Classes="secondary" />
                                    <TextBlock Grid.Column="2" Text="Artist" Classes="secondary" />
                                    <TextBlock Grid.Column="3" Text="Album" Classes="secondary" />
                                    <TextBlock Grid.Column="4" Text="Time" Classes="secondary" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="vm:PlaylistTrackItemRow">
                                <Border Classes="rowPlate">
                                <Grid ColumnDefinitions="40,*,180,220,64" Height="40">
                                    <controls:ArtworkImage Grid.Column="0" Width="40" Height="40" DisplaySize="40" CornerRadius="6"
                                            ServerId="{Binding Track.ServerId}" ArtworkKey="{Binding Track.ArtworkKey}"
                                            FallbackText="{Binding Track.AlbumTitle}" FallbackFontSize="15" FallbackForeground="#88FFFFFF" />
                                    <TextBlock Grid.Column="1" Text="{Binding Track.Title}" Classes="primary"
                                               VerticalAlignment="Center" Margin="13,0" />
                                    <Button Grid.Column="2" Classes="link" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Command="{Binding $parent[Window].DataContext.OpenTrackArtistCommand}"
                                            CommandParameter="{Binding Track}">
                                        <TextBlock Text="{Binding Track.ArtistName}" Classes="secondary" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="link" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Command="{Binding $parent[Window].DataContext.OpenTrackAlbumCommand}"
                                            CommandParameter="{Binding Track}">
                                        <TextBlock Text="{Binding Track.AlbumTitle}" Classes="secondary" />
                                    </Button>
                                    <TextBlock Grid.Column="4" Text="{Binding Track.Duration}" Classes="secondary"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>

                    <!-- Settings: desktop parity for the phone Settings stack. -->
                    <ScrollViewer IsVisible="{Binding ShowSettings}">
                     <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,8,28">

                       <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}" CornerRadius="12" Padding="18">
                         <StackPanel Spacing="14">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                             <controls:TablerIcon Size="21" Data="{StaticResource IconServer}" Brush="{DynamicResource Accent}" />
                             <TextBlock Text="Server" Classes="sectionTitle" />
                           </StackPanel>
                           <TextBlock Text="{Binding ActiveAccount.ServerName, FallbackValue='No server signed in'}"
                                      Classes="primary" FontSize="16" />
                           <TextBlock Text="{Binding ActiveAccount.BaseUrl}" Classes="secondary"
                                      IsVisible="{Binding HasActiveAccount}" />
                           <TextBlock Text="{Binding LibrarySummary}" Classes="secondary" />
                           <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasActiveAccount}">
                             <Button Content="Sync Now" Classes="accent"
                                     IsEnabled="{Binding !Connect.IsSyncing}"
                                     Command="{Binding SyncNowCommand}" />
                             <Button Content="Refresh Settings"
                                     Command="{Binding RefreshSettingsPanelCommand}" />
                           </StackPanel>
                           <StackPanel Spacing="7" IsVisible="{Binding Connect.IsSyncing}">
                             <ProgressBar Value="{Binding Connect.SyncProgress}" Maximum="1"
                                          IsIndeterminate="{Binding !Connect.SyncProgress}"
                                          Height="4" CornerRadius="2" />
                             <TextBlock Text="{Binding Connect.SyncDetail}" Classes="secondary" FontSize="11.5" />
                           </StackPanel>
                         </StackPanel>
                       </Border>

                       <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}" CornerRadius="12" Padding="18"
                               IsVisible="{Binding HasSettingsLibraries}">
                         <StackPanel Spacing="12">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                             <controls:TablerIcon Size="21" Data="{StaticResource IconStack}" Brush="{DynamicResource Accent}" />
                             <TextBlock Text="Music Libraries" Classes="sectionTitle" />
                           </StackPanel>
                           <TextBlock Text="Pick the library this desktop syncs. Changing it re-attaches the server and syncs."
                                      Classes="secondary" TextWrapping="Wrap" />
                           <ItemsControl ItemsSource="{Binding SettingsLibraries}">
                             <ItemsControl.ItemTemplate>
                               <DataTemplate>
                                 <Button Classes="tile card" Margin="0,0,0,8"
                                         Command="{Binding $parent[ScrollViewer].DataContext.SelectMusicLibraryCommand}"
                                         CommandParameter="{Binding}">
                                   <Border Classes="tileSurface" CornerRadius="9" Padding="12">
                                     <Grid ColumnDefinitions="*,Auto">
                                       <StackPanel Grid.Column="0" Spacing="3">
                                         <TextBlock Text="{Binding Name}" Classes="primary" />
                                         <TextBlock Text="{Binding Status}" Classes="secondary" />
                                       </StackPanel>
                                       <controls:TablerIcon Grid.Column="1" Size="19" Data="{StaticResource IconCheck}"
                                                            Brush="{DynamicResource Accent}"
                                                            IsVisible="{Binding IsSelected}" />
                                     </Grid>
                                   </Border>
                                 </Button>
                               </DataTemplate>
                             </ItemsControl.ItemTemplate>
                           </ItemsControl>
                         </StackPanel>
                       </Border>

                       <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}" CornerRadius="12" Padding="18">
                         <StackPanel Spacing="14">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                             <controls:TablerIcon Size="21" Data="{StaticResource IconVolume}" Brush="{DynamicResource Accent}" />
                             <TextBlock Text="Playback" Classes="sectionTitle" />
                           </StackPanel>
                           <CheckBox Content="Volume Normalization"
                                     IsChecked="{Binding NormalizationEnabled}" />
                         </StackPanel>
                       </Border>

                       <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}" CornerRadius="12" Padding="18">
                         <StackPanel Spacing="14">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                             <controls:TablerIcon Size="21" Data="{StaticResource IconWaveform}" Brush="{DynamicResource Accent}" />
                             <TextBlock Text="Equalizer" Classes="sectionTitle" />
                           </StackPanel>
                           <CheckBox Content="Equalizer" IsChecked="{Binding EqualizerEnabled}" />
                           <ItemsControl ItemsSource="{Binding EqualizerPresetOptions}">
                             <ItemsControl.ItemsPanel>
                               <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                             </ItemsControl.ItemsPanel>
                             <ItemsControl.ItemTemplate>
                               <DataTemplate>
                                 <Button Content="{Binding Label}" Classes="small" Margin="0,0,8,8"
                                         Command="{Binding $parent[ScrollViewer].DataContext.ApplyEqualizerPresetCommand}"
                                         CommandParameter="{Binding}" />
                               </DataTemplate>
                             </ItemsControl.ItemTemplate>
                           </ItemsControl>
                           <ItemsControl ItemsSource="{Binding EqualizerBands}">
                             <ItemsControl.ItemTemplate>
                               <DataTemplate>
                                 <Grid ColumnDefinitions="52,*,62" Margin="0,0,0,8">
                                   <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="secondary"
                                              VerticalAlignment="Center" />
                                   <Slider Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5"
                                           Value="{Binding Gain}" />
                                   <TextBlock Grid.Column="2" Text="{Binding GainText}" Classes="secondary"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                 </Grid>
                               </DataTemplate>
                             </ItemsControl.ItemTemplate>
                           </ItemsControl>
                           <Grid ColumnDefinitions="72,*,62">
                             <TextBlock Grid.Column="0" Text="Preamp" Classes="secondary" VerticalAlignment="Center" />
                             <Slider Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5"
                                     Value="{Binding EqualizerPreamp}" />
                             <TextBlock Grid.Column="2" Text="{Binding EqualizerPreampText}" Classes="secondary"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                           </Grid>
                           <Button Content="Reset to Flat" HorizontalAlignment="Left"
                                   Command="{Binding ResetEqualizerCommand}" />
                         </StackPanel>
                       </Border>

                       <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}" CornerRadius="12" Padding="18">
                         <StackPanel Spacing="12">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                             <controls:TablerIcon Size="21" Data="{StaticResource IconQuote}" Brush="{DynamicResource Accent}" />
                             <TextBlock Text="Lyrics" Classes="sectionTitle" />
                           </StackPanel>
                           <TextBlock Text="Desktop lyrics display and offline lyric capture need shared core/FFI support before they can be configured here."
                                      Classes="secondary" TextWrapping="Wrap" />
                         </StackPanel>
                       </Border>

                       <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}" CornerRadius="12" Padding="18">
                         <StackPanel Spacing="14">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                             <controls:TablerIcon Size="21" Data="{StaticResource IconSparkles}" Brush="{DynamicResource Accent}" />
                             <TextBlock Text="Recommendations" Classes="sectionTitle" />
                           </StackPanel>
                           <TextBlock Text="MusicBrainz enrichment needs a desktop FFI command before this can become a real control."
                                      Classes="secondary" TextWrapping="Wrap" />
                           <TextBlock Text="Not Recommended" Classes="primary" FontWeight="SemiBold" />
                           <TextBlock Text="Nothing hidden" Classes="secondary"
                                      IsVisible="{Binding !HasSuppressions}" />
                           <ItemsControl ItemsSource="{Binding SuppressedArtists}">
                             <ItemsControl.ItemTemplate>
                               <DataTemplate>
                                 <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                   <StackPanel Grid.Column="0">
                                     <TextBlock Text="{Binding Title}" Classes="primary" />
                                     <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                                   </StackPanel>
                                   <Button Grid.Column="1" Content="Restore" Classes="small"
                                           Command="{Binding $parent[ScrollViewer].DataContext.RestoreSuppressionCommand}"
                                           CommandParameter="{Binding}" />
                                 </Grid>
                               </DataTemplate>
                             </ItemsControl.ItemTemplate>
                           </ItemsControl>
                           <ItemsControl ItemsSource="{Binding SuppressedTracks}">
                             <ItemsControl.ItemTemplate>
                               <DataTemplate>
                                 <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                   <StackPanel Grid.Column="0">
                                     <TextBlock Text="{Binding Title}" Classes="primary" />
                                     <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                                   </StackPanel>
                                   <Button Grid.Column="1" Content="Restore" Classes="small"
                                           Command="{Binding $parent[ScrollViewer].DataContext.RestoreSuppressionCommand}"
                                           CommandParameter="{Binding}" />
                                 </Grid>
                               </DataTemplate>
                             </ItemsControl.ItemTemplate>
                           </ItemsControl>
                         </StackPanel>
                       </Border>

                       <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}" CornerRadius="12" Padding="18">
                         <StackPanel Spacing="14">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                             <controls:TablerIcon Size="21" Data="{StaticResource IconPalette}" Brush="{DynamicResource Accent}" />
                             <TextBlock Text="Appearance" Classes="sectionTitle" />
                           </StackPanel>
                           <TextBlock Text="Theme" Classes="primary" />
                           <StackPanel Orientation="Horizontal" Spacing="8">
                             <RadioButton Content="System" GroupName="appearance"
                                          IsChecked="{Binding Appearance, Converter={StaticResource StringMatch}, ConverterParameter=system}" />
                             <RadioButton Content="Light" GroupName="appearance"
                                          IsChecked="{Binding Appearance, Converter={StaticResource StringMatch}, ConverterParameter=light}" />
                             <RadioButton Content="Dark" GroupName="appearance"
                                          IsChecked="{Binding Appearance, Converter={StaticResource StringMatch}, ConverterParameter=dark}" />
                           </StackPanel>
                           <TextBlock Text="Dark Style" Classes="primary" />
                           <StackPanel Orientation="Horizontal" Spacing="8">
                             <RadioButton Content="Dim" GroupName="darkstyle"
                                          IsChecked="{Binding DarkStyle, Converter={StaticResource StringMatch}, ConverterParameter=dim}" />
                             <RadioButton Content="Black" GroupName="darkstyle"
                                          IsChecked="{Binding DarkStyle, Converter={StaticResource StringMatch}, ConverterParameter=black}" />
                           </StackPanel>
                         </StackPanel>
                       </Border>

                       <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}" CornerRadius="12" Padding="18">
                         <StackPanel Spacing="12">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                             <controls:TablerIcon Size="21" Data="{StaticResource IconStethoscope}" Brush="{DynamicResource Accent}" />
                             <TextBlock Text="Diagnostics" Classes="sectionTitle" />
                           </StackPanel>
                           <TextBlock Text="{Binding SecretStorageDescription}" Classes="secondary" TextWrapping="Wrap" />
                           <TextBlock Text="{Binding SettingsStorageDescription}" Classes="secondary" TextWrapping="Wrap" />
                           <TextBlock Text="{Binding DeviceIdentityDescription}" Classes="secondary" TextWrapping="Wrap" />
                           <TextBlock Text="{Binding Connect.SyncDetail}" Classes="secondary" TextWrapping="Wrap" />
                         </StackPanel>
                       </Border>

                       <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}" CornerRadius="12" Padding="18">
                         <StackPanel Spacing="12">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                             <controls:TablerIcon Size="21" Data="{StaticResource IconInfo}" Brush="{DynamicResource Accent}" />
                             <TextBlock Text="About" Classes="sectionTitle" />
                           </StackPanel>
                           <TextBlock Text="One app for your music, wherever it lives. Free forever. Open source."
                                      Classes="primary" TextWrapping="Wrap" />
                           <TextBlock Text="GPL-3.0 · Source on GitHub: https://github.com/thatcube/Mozz"
                                      Classes="secondary" TextWrapping="Wrap" />
                         </StackPanel>
                       </Border>

                       <Button Content="Sign Out" Classes="danger" HorizontalAlignment="Left"
                               IsVisible="{Binding HasActiveAccount}"
                               Command="{Binding SignOutCommand}" />
                       <TextBlock Text="{Binding SettingsMessage}" Classes="secondary" TextWrapping="Wrap"
                                  IsVisible="{Binding SettingsMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                     </StackPanel>
                    </ScrollViewer>

                    <!-- Servers: sign in, and mirror a catalog. -->
                    <ScrollViewer IsVisible="{Binding ShowConnect}">
                      <StackPanel Spacing="26" MaxWidth="560" HorizontalAlignment="Left">

                        <!-- Already signed in -->
                        <StackPanel Spacing="12" IsVisible="{Binding Connect.HasAccounts}">
                          <TextBlock Text="Your servers" Classes="sectionTitle" />
                          <ItemsControl ItemsSource="{Binding Connect.Accounts}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="{DynamicResource SurfaceBorderThickness}"
                                        CornerRadius="10" Padding="15,13" Margin="0,0,0,9">
                                  <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                      <TextBlock Text="{Binding ServerName}" Classes="primary" />
                                      <TextBlock Text="{Binding BaseUrl}" Classes="secondary" FontSize="11.5" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Sync" Classes="small" Margin="0,0,8,0"
                                            Command="{Binding $parent[ScrollViewer].DataContext.Connect.SyncAccountCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="2" Content="Sign out" Classes="small ghost"
                                            Command="{Binding $parent[ScrollViewer].DataContext.Connect.ForgetAccountCommand}"
                                            CommandParameter="{Binding}" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <!-- Add one -->
                        <StackPanel Spacing="13">
                          <TextBlock Text="Add a server" Classes="sectionTitle" />

                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton Content="Jellyfin" GroupName="kind"
                                         IsChecked="{Binding Connect.Kind, Converter={StaticResource EnumMatch}, ConverterParameter=Jellyfin}" />
                            <RadioButton Content="Plex" GroupName="kind"
                                         IsChecked="{Binding Connect.Kind, Converter={StaticResource EnumMatch}, ConverterParameter=Plex}" />
                            <RadioButton Content="Subsonic" GroupName="kind"
                                         IsChecked="{Binding Connect.Kind, Converter={StaticResource EnumMatch}, ConverterParameter=Subsonic}" />
                          </StackPanel>

                          <StackPanel Spacing="9" IsVisible="{Binding Connect.NeedsCredentials}">
                            <TextBox Text="{Binding Connect.ServerUrl}"
                                     PlaceholderText="192.168.1.10:8096"
                                     CornerRadius="8" Padding="11,9"
                                     Background="{DynamicResource SurfaceRaised}"
                                     BorderBrush="{DynamicResource SurfaceBorder}"
                                     BorderThickness="{DynamicResource SurfaceBorderThickness}" />
                            <TextBox Text="{Binding Connect.Username}"
                                     PlaceholderText="Username"
                                     CornerRadius="8" Padding="11,9"
                                     Background="{DynamicResource SurfaceRaised}"
                                     BorderBrush="{DynamicResource SurfaceBorder}"
                                     BorderThickness="{DynamicResource SurfaceBorderThickness}" />
                            <TextBox Text="{Binding Connect.Password}"
                                     PasswordChar="•"
                                     PlaceholderText="Password"
                                     CornerRadius="8" Padding="11,9"
                                     Background="{DynamicResource SurfaceRaised}"
                                     BorderBrush="{DynamicResource SurfaceBorder}"
                                     BorderThickness="{DynamicResource SurfaceBorderThickness}" />
                          </StackPanel>

                          <TextBlock Classes="secondary" TextWrapping="Wrap"
                                     IsVisible="{Binding Connect.IsPlex}"
                                     Text="Plex signs in through plex.tv rather than a password. Press Sign in and Mozz will give you a link to approve." />

                          <!-- Plex link.
                               The link, not the code: Mozz requests a "strong"
                               PIN, which is a 25-character token that app.plex.tv
                               requires and that nobody is meant to type. Showing
                               it large invites exactly the wrong thing. -->
                          <Border IsVisible="{Binding Connect.PlexLinkUrl, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  Background="{DynamicResource SurfaceRaised}"
                                  BorderBrush="{DynamicResource SurfaceBorder}"
                                  BorderThickness="{DynamicResource SurfaceBorderThickness}"
                                  CornerRadius="10" Padding="15,14">
                            <StackPanel Spacing="11">
                              <TextBlock Text="Approve Mozz in your browser"
                                         Classes="primary" FontWeight="SemiBold" />
                              <TextBlock Classes="secondary" FontSize="11.5" TextWrapping="Wrap"
                                         Text="This opens plex.tv. Sign in there and Mozz will connect by itself — nothing to type back here." />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Open Plex" Classes="accent"
                                        Command="{Binding Connect.OpenPlexLinkCommand}" />
                                <Button Content="Copy link"
                                        Command="{Binding Connect.CopyPlexLinkCommand}" />
                                <Button Content="Cancel" Classes="ghost"
                                        Command="{Binding Connect.CancelPlexCommand}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>

                          <Button Content="Sign in" Classes="accent" HorizontalAlignment="Left"
                                  IsEnabled="{Binding !Connect.IsBusy}"
                                  Command="{Binding Connect.SignInCommand}" />

                          <TextBlock Text="{Binding Connect.Message}" Classes="secondary" TextWrapping="Wrap"
                                     IsVisible="{Binding Connect.Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

                          <StackPanel Spacing="7" IsVisible="{Binding Connect.IsSyncing}">
                            <ProgressBar Value="{Binding Connect.SyncProgress}" Maximum="1"
                                         IsIndeterminate="{Binding !Connect.SyncProgress}"
                                         Height="4" CornerRadius="2" />
                            <TextBlock Text="{Binding Connect.SyncDetail}" Classes="secondary" FontSize="11.5" />
                          </StackPanel>
                          <TextBlock Text="{Binding Connect.SyncDetail}" Classes="secondary" FontSize="11.5"
                                     IsVisible="{Binding !Connect.IsSyncing}" />
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                </Panel>

            </Grid>
        </Grid>

        <!-- Now playing.
             Three columns that each own one job: what is playing, the transport
             that drives it, and the controls that sit beside it. The middle one
             is centred on the window rather than on the space left over, which is
             why this is a Grid with two starred flanks rather than a DockPanel —
             the play button lands on the window's centre line no matter how long
             the track title is. -->
        <Border Grid.Row="1" Height="96"
                Background="{DynamicResource BarBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,*" Margin="22,0">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3"
                            VerticalAlignment="Center">
                    <Button Classes="tile" Padding="8"
                            Command="{Binding OpenPlayerCommand}"
                            IsEnabled="{Binding HasNowPlaying}"
                            ToolTip.Tip="Open player">
                        <controls:ArtworkImage Width="58" Height="58" DisplaySize="58"
                                CornerRadius="7"
                                ServerId="{Binding NowPlaying.ServerId}"
                                ArtworkKey="{Binding NowPlaying.ArtworkKey}"
                                FallbackText="{Binding NowPlaying.AlbumTitle}"
                                FallbackFontSize="20"
                                FallbackFontWeight="SemiBold"
                                FallbackForeground="#66FFFFFF" />
                    </Button>
                    <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="260">
                        <Button Classes="link"
                                Command="{Binding OpenPlayerCommand}"
                                IsEnabled="{Binding HasNowPlaying}"
                                ToolTip.Tip="Open player">
                            <TextBlock Classes="primary" FontWeight="Medium"
                                       Text="{Binding NowPlaying.Title, FallbackValue='Not playing'}" />
                        </Button>
                        <Button Classes="link"
                                Command="{Binding OpenNowPlayingArtistCommand}"
                                IsEnabled="{Binding HasNowPlaying}">
                            <TextBlock Classes="secondary"
                                       Text="{Binding NowPlaying.ArtistName, FallbackValue=''}" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="11" HorizontalAlignment="Center">
                        <Button Classes="transport" Classes.active="{Binding IsShuffled}"
                                Command="{Binding ToggleShuffleCommand}"
                                ToolTip.Tip="Shuffle">
                            <controls:TablerIcon Size="19" Data="{StaticResource IconShuffle}"
                                                 Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button Classes="transport lead" Command="{Binding PreviousCommand}"
                                IsEnabled="{Binding HasNowPlaying}"
                                ToolTip.Tip="Previous">
                            <controls:TablerIcon Size="18" Filled="True" Data="{StaticResource IconSkipBack}"
                                                 Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button Classes="play" Command="{Binding TogglePlayPauseCommand}"
                                IsEnabled="{Binding HasNowPlaying}">
                            <Panel>
                                <controls:TablerIcon Size="20" Filled="True" Data="{StaticResource IconPlay}"
                                                     Brush="{Binding $parent[Button].Foreground}"
                                                     IsVisible="{Binding !IsPlaying}" />
                                <controls:TablerIcon Size="20" Filled="True" Data="{StaticResource IconPause}"
                                                     Brush="{Binding $parent[Button].Foreground}"
                                                     IsVisible="{Binding IsPlaying}" />
                            </Panel>
                        </Button>
                        <Button Classes="transport lead" Command="{Binding NextCommand}"
                                IsEnabled="{Binding HasNextTrack}"
                                ToolTip.Tip="Next">
                            <controls:TablerIcon Size="18" Filled="True" Data="{StaticResource IconSkipForward}"
                                                 Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <!-- Repeat is three-state, so the glyph carries the third:
                             the plain loop for "repeat all" and the loop with a 1
                             for "repeat this track". Colour alone cannot say which. -->
                        <Button Classes="transport" Classes.active="{Binding IsRepeatActive}"
                                Command="{Binding CycleRepeatCommand}"
                                ToolTip.Tip="Repeat">
                            <Panel>
                                <controls:TablerIcon Size="19" Data="{StaticResource IconRepeat}"
                                                     Brush="{Binding $parent[Button].Foreground}"
                                                     IsVisible="{Binding !IsRepeatOne}" />
                                <controls:TablerIcon Size="19" Data="{StaticResource IconRepeatOnce}"
                                                     Brush="{Binding $parent[Button].Foreground}"
                                                     IsVisible="{Binding IsRepeatOne}" />
                            </Panel>
                        </Button>
                    </StackPanel>

                    <controls:SeekBar Width="468"
                                      Position="{Binding PositionSeconds}"
                                      Duration="{Binding DurationSeconds}"
                                      TrackKey="{Binding NowPlayingKey}"
                                      FormatLabel="{Binding NowPlayingFormat}"
                                      SeekCommand="{Binding SeekToCommand}"
                                      Tint="{DynamicResource TextPrimary}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="transport" Classes.active="{Binding IsQueueOpen}"
                            Command="{Binding ToggleQueueCommand}"
                            ToolTip.Tip="Up next">
                        <controls:TablerIcon Size="19" Data="{StaticResource IconQueue}"
                                             Brush="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button Classes="transport" Command="{Binding ToggleMuteCommand}"
                            ToolTip.Tip="Mute">
                        <Panel>
                            <controls:TablerIcon Size="19" Data="{StaticResource IconVolume}"
                                                 Brush="{Binding $parent[Button].Foreground}"
                                                 IsVisible="{Binding !IsMuted}" />
                            <controls:TablerIcon Size="19" Data="{StaticResource IconVolumeOff}"
                                                 Brush="{Binding $parent[Button].Foreground}"
                                                 IsVisible="{Binding IsMuted}" />
                        </Panel>
                    </Button>
                    <controls:SeekBar Width="104"
                                      Position="{Binding Volume, Mode=TwoWay}"
                                      Duration="1"
                                      IsContinuous="True"
                                      ShowLabels="False"
                                      RestHeight="5" ActiveHeight="9"
                                      KeyboardStep="0.05"
                                      Tint="{DynamicResource TextPrimary}"
                                      VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The full player.
             A screen, not a panel: it covers the sidebar and the transport both,
             because what makes this feel like *the player* rather than a large
             artwork pane is that nothing else is on screen while it is up. The
             phone does the same thing by morphing the mini bar into a full
             sheet; the mechanism differs, the result should not.

             Its transport is the same controls as the bar's, one rung up the
             size scale — not a second set of styles. -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsPlayerOpen}"
                Background="{Binding PlayerBackground}">
            <!-- The player is always dark, on every platform and in every theme,
                 because its foreground is white over whatever colour the record
                 turned out to be. Overriding the text tiers for this subtree is
                 what makes that true for everything inside it at once — the type,
                 the transport icons, the seek bar's tint — instead of each one
                 hard-coding white and the Light theme quietly breaking one of
                 them. The values are the dark palette's own. -->
            <Border.Resources>
                <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F4" />
                <SolidColorBrush x:Key="TextSecondary" Color="#B9B9C1" />
                <SolidColorBrush x:Key="TextTertiary" Color="#8E8E97" />
                <SolidColorBrush x:Key="SurfaceHover" Color="#26FFFFFF" />
                <SolidColorBrush x:Key="SurfaceSelected" Color="#3AFFFFFF" />
                <SolidColorBrush x:Key="SurfaceRaised" Color="#1AFFFFFF" />
                <SolidColorBrush x:Key="Accent" Color="#FFFFFF" />
                <SolidColorBrush x:Key="AccentHover" Color="#FFFFFF" />
                <SolidColorBrush x:Key="AccentDeep" Color="#D5D5DC" />
            </Border.Resources>
            <Panel>
                <!-- A wash over the tones, densest at the bottom where the
                     controls are and lightest at the top where there is only
                     colour to show off. It is what keeps the seek bar and the
                     time labels legible over a pale record without darkening the
                     whole field to mud. -->
                <Border Background="{DynamicResource PlayerScrim}" />

                <Grid RowDefinitions="Auto,*,Auto" Margin="30,20,30,34">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="transport"
                                Command="{Binding ClosePlayerCommand}"
                                ToolTip.Tip="Close player">
                            <controls:TablerIcon Size="20" Data="{StaticResource IconChevronLeft}"
                                                 Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button Grid.Column="1" Classes="link"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding OpenNowPlayingAlbumCommand}">
                            <TextBlock Classes="playerCaption"
                                       Text="{Binding NowPlayingContext, FallbackValue=''}" />
                        </Button>
                        <Button Grid.Column="2" Classes="transport"
                                Classes.active="{Binding IsQueueOpen}"
                                Command="{Binding ToggleQueueCommand}"
                                ToolTip.Tip="Up next">
                            <controls:TablerIcon Size="19" Data="{StaticResource IconQueue}"
                                                 Brush="{Binding $parent[Button].Foreground}" />
                        </Button>
                    </Grid>

                    <!-- The cover keeps its own square however the window is
                         shaped, and the row below never gets pushed off. -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                             Margin="0,22,0,26" MaxHeight="420">
                        <Border Classes="albumArt" CornerRadius="14"
                                Width="420" Height="420"
                                BoxShadow="0 26 70 -20 #B3000000">
                            <controls:ArtworkImage Width="420" Height="420" DisplaySize="420"
                                    CornerRadius="14"
                                    ServerId="{Binding NowPlaying.ServerId}"
                                    ArtworkKey="{Binding NowPlaying.ArtworkKey}"
                                    FallbackText="{Binding NowPlaying.AlbumTitle}"
                                    FallbackFontSize="96"
                                    FallbackFontWeight="SemiBold"
                                    FallbackForeground="#55FFFFFF" />
                        </Border>
                    </Viewbox>

                    <StackPanel Grid.Row="2" Spacing="18" MaxWidth="620"
                                HorizontalAlignment="Center">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="playerTitle" TextAlignment="Center"
                                       Text="{Binding NowPlaying.Title, FallbackValue=''}" />
                            <Button Classes="link" HorizontalAlignment="Center"
                                    Command="{Binding OpenNowPlayingArtistCommand}">
                                <TextBlock Classes="playerArtist"
                                           Text="{Binding NowPlaying.ArtistName, FallbackValue=''}" />
                            </Button>
                        </StackPanel>

                        <controls:SeekBar Width="560"
                                          LabelFontSize="12"
                                          RestHeight="7" ActiveHeight="14"
                                          Position="{Binding PositionSeconds}"
                                          Duration="{Binding DurationSeconds}"
                                          TrackKey="{Binding NowPlayingKey}"
                                          FormatLabel="{Binding NowPlayingFormat}"
                                          SeekCommand="{Binding SeekToCommand}"
                                          Tint="{DynamicResource TextPrimary}" />

                        <StackPanel Orientation="Horizontal" Spacing="16"
                                    HorizontalAlignment="Center">
                            <Button Classes="transport big" Classes.active="{Binding IsShuffled}"
                                    Command="{Binding ToggleShuffleCommand}"
                                    ToolTip.Tip="Shuffle">
                                <controls:TablerIcon Size="23" Data="{StaticResource IconShuffle}"
                                                     Brush="{Binding $parent[Button].Foreground}" />
                            </Button>
                            <Button Classes="transport lead big" Command="{Binding PreviousCommand}"
                                    ToolTip.Tip="Previous">
                                <controls:TablerIcon Size="24" Filled="True" Data="{StaticResource IconSkipBack}"
                                                     Brush="{Binding $parent[Button].Foreground}" />
                            </Button>
                            <Button Classes="play big onArtwork" Command="{Binding TogglePlayPauseCommand}">
                                <Panel>
                                    <controls:TablerIcon Size="30" Filled="True" Data="{StaticResource IconPlay}"
                                                         Brush="{Binding $parent[Button].Foreground}"
                                                         IsVisible="{Binding !IsPlaying}" />
                                    <controls:TablerIcon Size="30" Filled="True" Data="{StaticResource IconPause}"
                                                         Brush="{Binding $parent[Button].Foreground}"
                                                         IsVisible="{Binding IsPlaying}" />
                                </Panel>
                            </Button>
                            <Button Classes="transport lead big" Command="{Binding NextCommand}"
                                    IsEnabled="{Binding HasNextTrack}"
                                    ToolTip.Tip="Next">
                                <controls:TablerIcon Size="24" Filled="True" Data="{StaticResource IconSkipForward}"
                                                     Brush="{Binding $parent[Button].Foreground}" />
                            </Button>
                            <Button Classes="transport big" Classes.active="{Binding IsRepeatActive}"
                                    Command="{Binding CycleRepeatCommand}"
                                    ToolTip.Tip="Repeat">
                                <Panel>
                                    <controls:TablerIcon Size="23" Data="{StaticResource IconRepeat}"
                                                         Brush="{Binding $parent[Button].Foreground}"
                                                         IsVisible="{Binding !IsRepeatOne}" />
                                    <controls:TablerIcon Size="23" Data="{StaticResource IconRepeatOnce}"
                                                         Brush="{Binding $parent[Button].Foreground}"
                                                         IsVisible="{Binding IsRepeatOne}" />
                                </Panel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center">
                            <Button Classes="transport" Command="{Binding ToggleMuteCommand}"
                                    ToolTip.Tip="Mute">
                                <Panel>
                                    <controls:TablerIcon Size="19" Data="{StaticResource IconVolume}"
                                                         Brush="{Binding $parent[Button].Foreground}"
                                                         IsVisible="{Binding !IsMuted}" />
                                    <controls:TablerIcon Size="19" Data="{StaticResource IconVolumeOff}"
                                                         Brush="{Binding $parent[Button].Foreground}"
                                                         IsVisible="{Binding IsMuted}" />
                                </Panel>
                            </Button>
                            <controls:SeekBar Width="132"
                                              Position="{Binding Volume, Mode=TwoWay}"
                                              Duration="1"
                                              IsContinuous="True"
                                              ShowLabels="False"
                                              RestHeight="5" ActiveHeight="9"
                                              KeyboardStep="0.05"
                                              Tint="{DynamicResource TextPrimary}"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>

        <!-- Up Next.
             An overlay rather than a fourth band: the queue is something you
             glance at and dismiss, and giving it permanent width would cost the
             library the space every time you were not looking at it. It floats
             over the content column, clear of the sidebar, and stops at the
             transport so the bar it was opened from stays visible. -->
    <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsQueueOpen}"
                Width="352" Margin="0,16,16,112"
                HorizontalAlignment="Right"
                Background="{DynamicResource BarBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1"
                CornerRadius="12"
                BoxShadow="0 18 48 -12 #99000000">
            <Grid RowDefinitions="Auto,*,Auto" Margin="16,14,10,14">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,6,12">
                    <TextBlock Text="Up Next" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="transport" Width="26" Height="26" CornerRadius="13"
                            Command="{Binding ToggleQueueCommand}" ToolTip.Tip="Close">
                        <controls:TablerIcon Size="15" Data="{StaticResource IconX}"
                                             Brush="{Binding $parent[Button].Foreground}" />
                    </Button>
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding UpNext}"
                         DoubleTapped="OnQueueRowActivated"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,0,6,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="rowPlate">
                                <Grid ColumnDefinitions="24,40,*,Auto" Height="40">
                                <TextBlock Grid.Column="0" Text="{Binding Ordinal}"
                                           Classes="secondary" FontSize="11.5"
                                           VerticalAlignment="Center" />
                                <controls:ArtworkImage Grid.Column="1"
                                        Width="40" Height="40" DisplaySize="40"
                                        CornerRadius="5"
                                        ServerId="{Binding Track.ServerId}"
                                        ArtworkKey="{Binding Track.ArtworkKey}"
                                        FallbackText="{Binding Track.AlbumTitle}"
                                        FallbackFontSize="13"
                                        FallbackFontWeight="SemiBold"
                                        FallbackForeground="#88FFFFFF" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            Margin="11,0,8,0" Spacing="1">
                                    <TextBlock Text="{Binding Track.Title}" Classes="primary" FontSize="13" />
                                    <TextBlock Text="{Binding Track.ArtistName}" Classes="secondary" FontSize="11.5" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Track.Duration}"
                                           Classes="secondary" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" Text="Nothing queued after this track."
                           Classes="secondary" FontSize="12.5"
                           TextWrapping="Wrap" MaxWidth="240"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"
                           IsVisible="{Binding !HasUpNext}" />

                <TextBlock Grid.Row="2" Text="Double-click a track to jump to it."
                           Classes="secondary" FontSize="11" Margin="0,12,6,0"
                           IsVisible="{Binding HasUpNext}" />
            </Grid>
        </Border>
    </Grid>
</Window>
