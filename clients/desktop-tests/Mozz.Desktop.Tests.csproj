<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Source files are included directly rather than through a ProjectReference.

    The app is a WinExe with a full Avalonia dependency tree; the thing worth
    testing here is the platform-native credential store, which needs no UI
    framework. Pulling Avalonia into a headless test run buys nothing and makes
    the run fragile on a CI machine with no display.

    This project also deliberately sits BESIDE clients/desktop rather than
    inside it. The .NET SDK globs every .cs file under a project directory, so a
    nested test project makes the app try to compile the tests — and the test
    project's generated obj/ assembly attributes along with them, which fails
    with a duplicate-attribute error that names neither cause.
  -->
  <ItemGroup>
    <Compile Include="..\desktop\Core\SecretStore.cs" />
    <Compile Include="..\desktop\Core\PairingWire.cs" />
    <Compile Include="..\desktop\Core\PairingLink.cs" />
    <Compile Include="..\desktop\Core\PairingDiscovery.cs" />
    <Compile Include="..\desktop\Core\PairingHost.cs" />
    <Compile Include="..\desktop\Core\CircleRoster.cs" />
    <Compile Include="..\desktop\Core\ServerSyncJournal.cs" />
    <!-- The generated command client. Included here for the same reason as
         everything else in this list: the wire-fixture conformance test has to
         check the SAME generated code the app ships, not a copy. -->
    <Compile Include="..\desktop\Generated\**\*.cs" />
    <Compile Include="..\desktop\Core\MozzCore.cs" />
    <Compile Include="..\desktop\Core\ArtworkUnavailableException.cs" />
    <Compile Include="..\desktop\Core\FailureReporter.cs" />
    <Compile Include="..\desktop\Core\RetrySchedule.cs" />
    <Compile Include="..\desktop\Core\DiskBudget.cs" />
    <Compile Include="..\desktop\Core\MozzServer.cs" />
    <Compile Include="..\desktop\Core\Downloads\DownloadModels.cs" />
    <Compile Include="..\desktop\Core\Downloads\ICoreInvoker.cs" />
    <Compile Include="..\desktop\Core\Downloads\IDownloadCommands.cs" />
    <Compile Include="..\desktop\Core\Downloads\DownloadCommands.cs" />
    <Compile Include="..\desktop\Core\Downloads\DownloadLayout.cs" />
    <Compile Include="..\desktop\Core\Downloads\DownloadService.cs" />
    <Compile Include="..\desktop\Core\Models.cs" />
    <Compile Include="..\desktop\Core\AppPreferences.cs" />
    <Compile Include="..\desktop\Core\MozzTheme.cs" />
    <Compile Include="..\desktop\Core\AppVersion.cs" />
    <Compile Include="..\desktop\Core\DesktopEqualizer.cs" />
    <Compile Include="..\desktop\Core\LibrarySelectionState.cs" />
    <Compile Include="..\desktop\Core\PlayHistoryRecorder.cs" />
    <Compile Include="..\desktop\Core\ArtworkPresentation.cs" />
    <Compile Include="..\desktop\ViewModels\GridRows.cs" />
    <Compile Include="..\desktop\ViewModels\HomeMixes.cs" />
    <Compile Include="..\desktop\ViewModels\LibraryNavigation.cs" />
    <Compile Include="..\desktop\ViewModels\DetailRows.cs" />
    <Compile Include="..\desktop\ViewModels\MediaDetailFormatting.cs" />
    <Compile Include="..\desktop\ViewModels\DownloadRows.cs" />
    <Compile Include="..\desktop\ViewModels\PlaybackQueue.cs" />
    <Compile Include="..\desktop\ViewModels\ContinuityPresentation.cs" />
    <Compile Include="..\desktop\ViewModels\SearchPresentation.cs" />
    <Compile Include="..\desktop\ViewModels\GenrePresentation.cs" />
    <Compile Include="..\desktop\ViewModels\SettingsModels.cs" />
    <Compile Include="..\desktop\Core\ArtworkCache.cs" />
    <Compile Include="..\desktop\Core\ArtworkBinder.cs" />
  </ItemGroup>

  <!--
    The audio engine's pure-managed code is compiled in directly too, for the
    same reason: it lets the byte-stream sources (file and HTTP) be tested
    headlessly, and because these files are platform-neutral BCL-only code the
    tests then run unchanged on the Windows CI leg.

    Audio\Native\** is excluded on purpose: those files P/Invoke the Rust
    engine's shared library (libmozz_audio_ffi), and nothing under test needs a
    sound card or the dylib. Excluding them keeps the native dependency out of
    the headless run entirely — the streaming layer beneath them is what the
    tests exercise, and it is pure managed code.
  -->
  <ItemGroup>
    <Compile Include="..\desktop\Audio\**\*.cs" Exclude="..\desktop\Audio\Native\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Google.Protobuf" Version="3.33.1" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
