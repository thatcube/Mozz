# Copy to `.env.fastlane` and fill in. That file is gitignored, as is the .p8
# key it points at -- never commit either.
#
# Values come from App Store Connect > Users and Access > Integrations >
# App Store Connect API. The key is downloadable exactly once, so keep it
# somewhere outside the repo that survives a fresh clone.
#
# Usage:  fastlane beta --env fastlane

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Contact details App Review shows when it has a question about the beta.
# Required once before an external TestFlight group can be submitted.
MOZZ_CONTACT_FIRST_NAME=
MOZZ_CONTACT_LAST_NAME=
MOZZ_CONTACT_EMAIL=
MOZZ_CONTACT_PHONE=

# Where tester feedback is sent, and how the app is described in TestFlight.
MOZZ_FEEDBACK_EMAIL=

# Mozz plays from a server the user owns, so App Review cannot get past the
# login screen without one. These are handed to the reviewer verbatim.
MOZZ_DEMO_SERVER_URL=
MOZZ_DEMO_ACCOUNT_NAME=
MOZZ_DEMO_ACCOUNT_PASSWORD=
