{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mozz-relay",
  "account_id": "471672cb7947a45f5e43023a1f02d2f5",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-27",
  "routes": [
    {
      "pattern": "relay.mozzmusic.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "B2_BUCKET_NAME": "mozz-relay",
    "B2_READ_ENDPOINT": "https://sync.mozzmusic.com/file/mozz-relay",
    "KEY_LIFETIME_SECONDS": "7776000"
  },
  "ratelimits": [
    {
      "name": "CHANNEL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
